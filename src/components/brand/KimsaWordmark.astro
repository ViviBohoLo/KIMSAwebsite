---
/**
 * KimsaWordmark — "KIMSA" con la montaña reemplazando la A.
 */
import MountainMark from './MountainMark.astro';

interface Props {
  color?: string;
  size?: number;
  mono?: string;
  class?: string;
}
const { color = 'var(--kimsa-ink)', size = 28, mono, class: className } = Astro.props;
const ms = size * 1.05;
---
<span
  class:list={['kimsa-wordmark', className]}
  style={`gap:${size * 0.08}px; font-size:${size}px; color:${color};`}
>
  <span>KIMS</span>
  <MountainMark size={ms} mono={mono} class="kw-mark" />
</span>

<style define:vars={{ nudge: '0px' }}>
  .kimsa-wordmark {
    display: inline-flex;
    align-items: center;
    font-family: var(--kimsa-font-sans);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
  }
  .kw-mark {
    margin-left: -0.05em;
    margin-bottom: -0.05em;
  }
</style>
