const socials = [
  { key: 'linkedin', href: 'https://www.linkedin.com/company/kimsa-co/', title: 'LinkedIn' },
  { key: 'instagram', href: 'https://www.instagram.com/kimsacolombia/?hl=es-la', title: 'Instagram' },
