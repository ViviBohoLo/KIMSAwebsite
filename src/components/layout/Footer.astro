];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__grid container">
    <div class="footer__brand">
      <KimsaLogo variant="blanco" height={34} />
      <p class="footer__tagline">
        Clima · Conservación · Desarrollo. Una consultora climática latinoamericana nacida en Bogotá en 2017.
      </p>
      <div class="footer__socials">
        {socials.map((s) => (
          <a class="footer__social" href={s.href} title={s.title} aria-label={s.title} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d={icons[s.key]} />
            </svg>
          </a>
        ))}
      </div>
    </div>
    {columns.map((col) => (
      <div class="footer__col">
        <div class="footer__col-title">{col.title}</div>
          {col.items.map((i) => (
            i.href
              ? <a 
                  class="footer__link" 
                  href={i.href} 
                  target={i.target} 
                  rel={i.target === '_blank' ? 'noopener noreferrer' : undefined}
                >
                  {i.label}
                </a>
              : <span class="footer__link footer__link--static">{i.label}</span>
        ))}
      </div>
    ))}
  </div>
  <div class="footer__legal container">
    <span>© {year} KIMSA S.A.S.</span>
    <span>Hecho con cuidado por gente de Latinoamérica</span>
  </div>
</footer>

<style>
  .footer {
    padding: 80px var(--kimsa-section-x) 40px;
    background: var(--kimsa-forest-deep);
    color: rgba(251, 248, 241, 0.78);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 56px;
    margin-bottom: 56px;
  }
  .footer__tagline {
    margin-top: 20px;
    font-size: 14px;
    line-height: 1.6;
    max-width: 320px;
  }
  .footer__socials { margin-top: 24px; display: flex; gap: 10px; }
  .footer__social {
    width: 40px;
    height: 40px;
    border-radius: var(--kimsa-radius-pill);
    background: var(--kimsa-terracotta);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    color: var(--kimsa-bone);
    transition: filter var(--kimsa-dur) var(--kimsa-ease);
  }
  .footer__social:hover { filter: brightness(1.08); }
  .footer__col-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--kimsa-peach);
    margin-bottom: 16px;
  }
  .footer__link {
    display: block;
    font-size: 14px;
    margin-bottom: 10px;
    color: rgba(251, 248, 241, 0.78);
    transition: color var(--kimsa-dur) var(--kimsa-ease);
  }
  a.footer__link:hover { color: var(--kimsa-bone); }
  .footer__link--static { cursor: default; }
  .footer__legal {
    padding-top: 24px;
    border-top: 1px solid rgba(251, 248, 241, 0.12);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 12px;
    color: rgba(251, 248, 241, 0.5);
  }
  @media (max-width: 900px) {
    .footer__grid { grid-template-columns: 1fr 1fr; gap: 36px; }
    .footer__legal { flex-direction: column; gap: 8px; }
  }
</style>
