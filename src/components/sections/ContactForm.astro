---
/**
 * ContactForm — sección de contacto reutilizable. Vive al final de la Home
 * (id="contacto", destino de los botones "Conversemos") y también encabeza
 * la página dedicada /contacto para quienes llegan navegando desde otras
 * páginas. Envía el formulario por POST (JSON) al webhook de n8n
 * ("Formulario Astro a Correo"), sin recargar la página.
 */
import Button from '../core/Button.astro';
import MountainMark from '../brand/MountainMark.astro';
import { CONTACT } from '../../data/site';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  variant?: 'home' | 'contacto';
}
const { variant = 'home' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const copyEs = {
  home: {
    eyebrow: 'Hablemos',
    titleMain: '¿Tiene un reto climático ',
    titleEm: 'en mente?',
    lead: 'Cuéntenos sobre su organización y el reto que enfrenta. Le respondemos en menos de 48 horas.',
  },
  contacto: {
    eyebrow: 'Formulario de contacto',
    titleMain: 'Cuéntenos en qué ',
    titleEm: 'podemos ayudar.',
    lead: 'Complete el formulario y nuestro equipo se pondrá en contacto en menos de 48 horas.',
  },
};
const copyEn = {
  home: {
    eyebrow: "Let's talk",
    titleMain: 'Have a climate challenge ',
    titleEm: 'in mind?',
    lead: 'Tell us about your organization and the challenge you face. We reply in less than 48 hours.',
  },
  contacto: {
    eyebrow: 'Contact form',
    titleMain: 'Tell us how we ',
    titleEm: 'can help.',
    lead: "Fill out the form and our team will get in touch in less than 48 hours.",
  },
};
const copy = (lang === 'en' ? copyEn : copyEs)[variant];
---
<section class="section contact-form" id="contacto">
  <div class="contact-form__grid container">
    <div class="reveal">
      <div class="contact-form__head">
        <span class="side-tag">{copy.eyebrow}</span>
        <h2 class="h2">{copy.titleMain}<em class="em-terracotta">{copy.titleEm}</em></h2>
      </div>
      <p class="lead contact-form__lead">{copy.lead}</p>
      <div class="contact-form__info">
        <a class="contact-form__info-item" href={CONTACT.mailto}>
          <span class="contact-form__info-label">{t('contact.email')}</span>
          <span>{CONTACT.email}</span>
        </a>
      </div>

      <!-- Cada sede lleva su propio teléfono/WhatsApp (números distintos por
           país) rotulado con la ciudad, para que quien llame o escriba sepa
           a qué oficina está marcando y no confunda Colombia con Costa Rica. -->
      <ul class="contact-form__hqs">
        {CONTACT.hqs.map((hq) => (
          <li class="contact-form__hq">
            <span class="contact-form__hq-badge" style={`background:linear-gradient(155deg, ${hq.color} 0%, color-mix(in srgb, ${hq.color} 55%, transparent) 140%)`}>
              <MountainMark size={20} />
            </span>
            <span class="contact-form__hq-text">
              <span class="contact-form__hq-city">{hq.city}</span>
              <span class="contact-form__hq-country-row">
                <span class="contact-form__hq-country">{hq.country}</span>
                <a class="contact-form__hq-phone" href={hq.whatsapp} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp ${hq.country}: ${hq.phone}`}>
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.2a8.15 8.15 0 0 1-4.16-1.14l-.3-.18-3.09.84.83-3.02-.2-.31A8.2 8.2 0 1 1 12 20.2zm4.52-6.13c-.25-.12-1.45-.72-1.67-.8-.22-.08-.39-.12-.55.12-.16.25-.63.8-.78.96-.14.16-.29.18-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42-.14-.01-.31-.01-.47-.01-.16 0-.43.06-.65.31-.22.25-.86.84-.86 2.05 0 1.21.88 2.38 1 2.54.12.16 1.74 2.66 4.22 3.73.59.25 1.05.4 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.45-.59 1.65-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.47-.28z"/></svg>
                  {hq.phone}
                </a>
              </span>
            </span>
          </li>
        ))}
      </ul>
    </div>

    <form class="contact-form__card reveal" data-endpoint={CONTACT.formWebhook} data-lang={lang} novalidate>
      <div class="contact-form__row">
        <label class="contact-form__field">
          <span>{t('contact.name')} <span class="contact-form__req" aria-hidden="true">*</span></span>
          <input type="text" name="nombre" autocomplete="name" placeholder={t('contact.namePlaceholder')} required aria-required="true" />
          <span class="contact-form__error" data-error-for="nombre"></span>
        </label>
        <label class="contact-form__field">
          <span>{t('contact.email')} <span class="contact-form__req" aria-hidden="true">*</span></span>
          <input type="email" name="email" autocomplete="email" placeholder={t('contact.emailPlaceholder')} required aria-required="true" />
          <span class="contact-form__error" data-error-for="email"></span>
        </label>
      </div>
      <div class="contact-form__row">
        <label class="contact-form__field">
          <span>{t('contact.phone')} <span class="contact-form__req" aria-hidden="true">*</span></span>
          <input type="tel" name="telefono" autocomplete="tel" placeholder={t('contact.phonePlaceholder')} required aria-required="true" />
          <span class="contact-form__error" data-error-for="telefono"></span>
        </label>
        <label class="contact-form__field">
          <span>{t('contact.subject')} <span class="contact-form__req" aria-hidden="true">*</span></span>
          <input type="text" name="asunto" placeholder={t('contact.subjectPlaceholder')} required aria-required="true" />
          <span class="contact-form__error" data-error-for="asunto"></span>
        </label>
      </div>
      <label class="contact-form__field">
        <span>{t('contact.message')} <span class="contact-form__req" aria-hidden="true">*</span> <span class="contact-form__hint">{t('contact.messageHint')}</span></span>
        <textarea name="mensaje" rows="5" placeholder={t('contact.messagePlaceholder')} required aria-required="true"></textarea>
        <span class="contact-form__error" data-error-for="mensaje"></span>
      </label>

      <!-- honeypot anti-spam: invisible para personas, tentador para bots -->
      <div class="contact-form__hp" aria-hidden="true">
        <label for="contact-website">{t('contact.honeypot')}</label>
        <input id="contact-website" type="text" name="sitio_web" tabindex="-1" autocomplete="off" />
      </div>

      <div class="contact-form__foot">
        <Button type="submit" size="lg" class="contact-form__submit">{t('contact.submit')}</Button>
        <p class="contact-form__status" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
</section>

<style>
  .contact-form { background: var(--kimsa-cream); scroll-margin-top: 110px; }
  .contact-form__grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 64px; align-items: start; }
  .contact-form__head { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-bottom: 24px; }
  .contact-form__lead { max-width: 460px; }
  .contact-form__info { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 32px; }
  .contact-form__info-item { display: flex; flex-direction: column; gap: 2px; font-size: 15px; color: var(--kimsa-ink); }
  a.contact-form__info-item:hover { color: var(--kimsa-terracotta); }
  .contact-form__info-label { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--kimsa-ink-soft); }

  .contact-form__hqs { list-style: none; margin-top: 28px; display: flex; flex-direction: column; gap: 14px; }
  .contact-form__hq { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .contact-form__hq-badge {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: var(--kimsa-radius-pill);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--kimsa-shadow-chip);
  }
  .contact-form__hq-text { min-width: 140px; }
  .contact-form__hq-city { display: block; font-weight: 600; font-size: 15px; color: var(--kimsa-ink); }
  .contact-form__hq-country-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 2px; }
  .contact-form__hq-country { font-size: 13px; color: var(--kimsa-ink-soft); }
  .contact-form__hq-phone {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 600;
    color: var(--kimsa-forest);
    background: var(--kimsa-tint-forest);
    border-radius: var(--kimsa-radius-pill);
    padding: 6px 12px;
    white-space: nowrap;
    transition: filter var(--kimsa-dur) var(--kimsa-ease);
  }
  .contact-form__hq-phone:hover { filter: brightness(0.95); }

  .contact-form__card {
    background: var(--kimsa-surface-card);
    border-radius: var(--kimsa-radius-2xl);
    box-shadow: var(--kimsa-shadow-card);
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .contact-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .contact-form__field { display: flex; flex-direction: column; gap: 8px; font-size: 13px; font-weight: 600; color: var(--kimsa-ink); }
  .contact-form__req { color: var(--kimsa-coral); }
  .contact-form__hint { font-weight: 400; font-size: 12px; color: var(--kimsa-ink-soft); }
  .contact-form__field input,
  .contact-form__field textarea {
    font-family: var(--kimsa-font-sans);
    font-size: 15px;
    font-weight: 400;
    color: var(--kimsa-ink);
    background: var(--kimsa-bone);
    border: 1.5px solid var(--kimsa-rule);
    border-radius: var(--kimsa-radius-md);
    padding: 13px 16px;
    resize: vertical;
    transition: border-color var(--kimsa-dur) var(--kimsa-ease);
  }
  .contact-form__field input:focus,
  .contact-form__field textarea:focus {
    outline: none;
    border-color: var(--kimsa-terracotta);
  }
  .contact-form__field :invalid { box-shadow: none; } /* evita el rojo nativo mientras se escribe */
  .contact-form__field input.is-invalid,
  .contact-form__field textarea.is-invalid { border-color: var(--kimsa-coral); }
  .contact-form__error { font-size: 12px; font-weight: 500; color: var(--kimsa-coral); min-height: 14px; }

  .contact-form__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .contact-form__foot { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .contact-form__submit { border: none; }
  .contact-form__submit:disabled { opacity: 0.6; cursor: not-allowed; }
  .contact-form__status { font-size: 14px; font-weight: 500; }
  .contact-form__status--success { color: var(--kimsa-forest); }
  .contact-form__status--error { color: var(--kimsa-coral); }

  @media (max-width: 900px) {
    .contact-form__grid { grid-template-columns: 1fr; gap: 40px; }
    .contact-form__card { padding: 28px; }
    .contact-form__row { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Envío del formulario de contacto por fetch (sin recargar), contra el
  // webhook de n8n. Patrón por querySelectorAll para tolerar que el
  // componente aparezca más de una vez en la página.
  const MIN_MESSAGE_WORDS = 10;
  const wordCount = (str) => (str.match(/\S+/g) || []).length;
  const isValidEmail = (str) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(str);
  const isValidPhone = (str) => str.replace(/[^0-9]/g, '').length >= 7;

  // Mensajes por idioma — el formulario aparece tanto en /es (sin prefijo)
  // como en /en/*, así que cada instancia lee su propio idioma de
  // data-lang (puesto por el frontmatter, ver arriba) en vez de asumir uno.
  const MESSAGES = {
    es: {
      name: 'Por favor indica tu nombre.',
      emailEmpty: 'Por favor indica tu correo.',
      emailInvalid: 'Ese correo no parece válido.',
      phoneEmpty: 'Por favor indica un teléfono de contacto.',
      phoneInvalid: 'Ese teléfono no parece válido.',
      subject: 'Por favor indica el asunto de tu mensaje.',
      messageEmpty: 'Cuéntanos brevemente tu mensaje.',
      messageShort: (n) => `Escribe al menos ${n} palabras para que podamos entender tu solicitud.`,
      reviewFields: 'Revisa los campos marcados antes de enviar.',
      sending: 'Enviando…',
      success: '¡Gracias! Recibimos tu mensaje y te contactaremos pronto.',
      error: 'Hubo un problema al enviar. Escríbenos directamente a info@kimsa.co.',
    },
    en: {
      name: 'Please enter your name.',
      emailEmpty: 'Please enter your email.',
      emailInvalid: "That email doesn't look valid.",
      phoneEmpty: 'Please enter a contact phone number.',
      phoneInvalid: "That phone number doesn't look valid.",
      subject: 'Please enter the subject of your message.',
      messageEmpty: 'Tell us briefly about your message.',
      messageShort: (n) => `Write at least ${n} words so we can understand your request.`,
      reviewFields: 'Please review the marked fields before submitting.',
      sending: 'Sending…',
      success: "Thank you! We've received your message and will contact you soon.",
      error: 'There was a problem sending your message. Write to us directly at info@kimsa.co.',
    },
  };

  document.querySelectorAll('.contact-form__card').forEach((form) => {
    const endpoint = form.dataset.endpoint;
    const M = MESSAGES[form.dataset.lang === 'en' ? 'en' : 'es'];
    const fieldRules = {
      nombre: (v) => (v.trim() ? '' : M.name),
      email: (v) => {
        const val = v.trim();
        if (!val) return M.emailEmpty;
        if (!isValidEmail(val)) return M.emailInvalid;
        return '';
      },
      telefono: (v) => {
        const val = v.trim();
        if (!val) return M.phoneEmpty;
        if (!isValidPhone(val)) return M.phoneInvalid;
        return '';
      },
      asunto: (v) => (v.trim() ? '' : M.subject),
      mensaje: (v) => {
        const val = v.trim();
        if (!val) return M.messageEmpty;
        if (wordCount(val) < MIN_MESSAGE_WORDS) return M.messageShort(MIN_MESSAGE_WORDS);
        return '';
      },
    };
    const submitBtn = form.querySelector('.contact-form__submit');
    const statusEl = form.querySelector('.contact-form__status');
    const submitLabel = submitBtn ? submitBtn.textContent : '';

    const setStatus = (type, msg) => {
      if (!statusEl) return;
      statusEl.textContent = msg;
      statusEl.className = 'contact-form__status' + (type ? ` contact-form__status--${type}` : '');
    };

    const clearFieldError = (name) => {
      const input = form.elements.namedItem(name);
      input?.classList.remove('is-invalid');
      const errorEl = form.querySelector(`[data-error-for="${name}"]`);
      if (errorEl) errorEl.textContent = '';
    };

    const validateField = (name) => {
      const input = form.elements.namedItem(name);
      const rule = fieldRules[name];
      if (!input || !rule) return true;
      const msg = rule(input.value);
      input.classList.toggle('is-invalid', !!msg);
      const errorEl = form.querySelector(`[data-error-for="${name}"]`);
      if (errorEl) errorEl.textContent = msg;
      return !msg;
    };

    // Valida en vivo una vez que el usuario ya intentó corregir un campo.
    Object.keys(fieldRules).forEach((name) => {
      const input = form.elements.namedItem(name);
      input?.addEventListener('blur', () => validateField(name));
      input?.addEventListener('input', () => {
        if (input.classList.contains('is-invalid')) validateField(name);
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!endpoint) return;

      // honeypot: si un bot lo rellenó, fingimos éxito y no enviamos nada.
      const honeypot = form.querySelector('[name="sitio_web"]');
      if (honeypot && honeypot.value) {
        form.reset();
        setStatus('success', M.success);
        return;
      }

      const names = Object.keys(fieldRules);
      const results = names.map((name) => validateField(name));
      if (results.includes(false)) {
        const firstInvalid = form.elements.namedItem(names[results.indexOf(false)]);
        firstInvalid?.focus();
        setStatus('error', M.reviewFields);
        return;
      }

      const data = {
        nombre: (form.elements.namedItem('nombre')?.value ?? '').trim(),
        email: (form.elements.namedItem('email')?.value ?? '').trim(),
        telefono: (form.elements.namedItem('telefono')?.value ?? '').trim(),
        asunto: (form.elements.namedItem('asunto')?.value ?? '').trim(),
        mensaje: (form.elements.namedItem('mensaje')?.value ?? '').trim(),
      };

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = M.sending;
      }
      setStatus('', '');

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error(`status ${res.status}`);
        form.reset();
        names.forEach(clearFieldError); // el reset vacía los campos; no re-validar contra vacío
        setStatus('success', M.success);
      } catch (err) {
        setStatus('error', M.error);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = submitLabel;
        }
      }
    });
  });
</script>
