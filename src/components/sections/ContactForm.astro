---
/**
 * ContactForm — sección de contacto reutilizable. Vive al final de la Home
 * (id="contacto", destino de los botones "Conversemos") y también encabeza
 * la página dedicada /contacto para quienes llegan navegando desde otras
 * páginas. Envía el formulario por POST (JSON) al webhook de n8n
 * ("Formulario Astro a Correo"), sin recargar la página.
 */
import Button from '../core/Button.astro';
import MountainMark from '../brand/MountainMark.astro';
import { CONTACT } from '../../data/site';

interface Props {
  variant?: 'home' | 'contacto';
}
const { variant = 'home' } = Astro.props;

const copy = {
  home: {
    eyebrow: 'Hablemos',
    titleMain: '¿Tiene un reto climático ',
    titleEm: 'en mente?',
    lead: 'Cuéntenos sobre su organización y el reto que enfrenta. Le respondemos en menos de 48 horas.',
  },
  contacto: {
    eyebrow: 'Formulario de contacto',
    titleMain: 'Cuéntenos en qué ',
    titleEm: 'podemos ayudar.',
    lead: 'Complete el formulario y nuestro equipo se pondrá en contacto en menos de 48 horas.',
  },
}[variant];
---
<section class="section contact-form" id="contacto">
  <div class="contact-form__grid container">
    <div class="reveal">
      <div class="contact-form__head">
        <span class="side-tag">{copy.eyebrow}</span>
        <h2 class="h2">{copy.titleMain}<em class="em-terracotta">{copy.titleEm}</em></h2>
      </div>
      <p class="lead contact-form__lead">{copy.lead}</p>
      <div class="contact-form__info">
        <a class="contact-form__info-item" href={CONTACT.mailto}>
          <span class="contact-form__info-label">Correo</span>
          <span>{CONTACT.email}</span>
        </a>
        <a class="contact-form__info-item" href="https://wa.me/573208675567" target="_blank" rel="noopener noreferrer">
          <span class="contact-form__info-label">WhatsApp</span>
          <span>{CONTACT.phone}</span>
        </a>
      </div>

      <ul class="contact-form__hqs">
        {CONTACT.hqs.map((hq) => (
          <li class="contact-form__hq">
            <span class="contact-form__hq-badge" style={`background:linear-gradient(155deg, ${hq.color} 0%, color-mix(in srgb, ${hq.color} 55%, transparent) 140%)`}>
              <MountainMark size={20} />
            </span>
            <span>
              <span class="contact-form__hq-city">{hq.city}</span>
              <span class="contact-form__hq-country">{hq.country}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>

    <form class="contact-form__card reveal" data-endpoint={CONTACT.formWebhook} novalidate>
      <div class="contact-form__row">
        <label class="contact-form__field">
          <span>Nombre <span class="contact-form__req" aria-hidden="true">*</span></span>
          <input type="text" name="nombre" autocomplete="name" placeholder="¿Cómo te llamas?" required aria-required="true" />
          <span class="contact-form__error" data-error-for="nombre"></span>
        </label>
        <label class="contact-form__field">
          <span>Correo <span class="contact-form__req" aria-hidden="true">*</span></span>
          <input type="email" name="email" autocomplete="email" placeholder="tucorreo@ejemplo.com" required aria-required="true" />
          <span class="contact-form__error" data-error-for="email"></span>
        </label>
      </div>
      <div class="contact-form__row">
        <label class="contact-form__field">
          <span>Teléfono / WhatsApp <span class="contact-form__req" aria-hidden="true">*</span></span>
          <input type="tel" name="telefono" autocomplete="tel" placeholder="+57 300 000 0000" required aria-required="true" />
          <span class="contact-form__error" data-error-for="telefono"></span>
        </label>
        <label class="contact-form__field">
          <span>Asunto <span class="contact-form__req" aria-hidden="true">*</span></span>
          <input type="text" name="asunto" placeholder="Ej. propuesta, alianza, prensa…" required aria-required="true" />
          <span class="contact-form__error" data-error-for="asunto"></span>
        </label>
      </div>
      <label class="contact-form__field">
        <span>Mensaje <span class="contact-form__req" aria-hidden="true">*</span> <span class="contact-form__hint">mínimo 10 palabras</span></span>
        <textarea name="mensaje" rows="5" placeholder="Cuéntanos un poco sobre tu proyecto o reto climático…" required aria-required="true"></textarea>
        <span class="contact-form__error" data-error-for="mensaje"></span>
      </label>

      <!-- honeypot anti-spam: invisible para personas, tentador para bots -->
      <div class="contact-form__hp" aria-hidden="true">
        <label for="contact-website">No completar este campo</label>
        <input id="contact-website" type="text" name="sitio_web" tabindex="-1" autocomplete="off" />
      </div>

      <div class="contact-form__foot">
        <Button type="submit" size="lg" class="contact-form__submit">Enviar mensaje →</Button>
        <p class="contact-form__status" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
</section>

<style>
  .contact-form { background: var(--kimsa-cream); scroll-margin-top: 110px; }
  .contact-form__grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 64px; align-items: start; }
  .contact-form__head { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-bottom: 24px; }
  .contact-form__lead { max-width: 460px; }
  .contact-form__info { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 32px; }
  .contact-form__info-item { display: flex; flex-direction: column; gap: 2px; font-size: 15px; color: var(--kimsa-ink); }
  a.contact-form__info-item:hover { color: var(--kimsa-terracotta); }
  .contact-form__info-label { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--kimsa-ink-soft); }

  .contact-form__hqs { list-style: none; margin-top: 28px; display: flex; flex-direction: column; gap: 14px; }
  .contact-form__hq { display: flex; align-items: center; gap: 14px; }
  .contact-form__hq-badge {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: var(--kimsa-radius-pill);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--kimsa-shadow-chip);
  }
  .contact-form__hq-city { display: block; font-weight: 600; font-size: 15px; color: var(--kimsa-ink); }
  .contact-form__hq-country { display: block; font-size: 13px; color: var(--kimsa-ink-soft); }

  .contact-form__card {
    background: var(--kimsa-surface-card);
    border-radius: var(--kimsa-radius-2xl);
    box-shadow: var(--kimsa-shadow-card);
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .contact-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .contact-form__field { display: flex; flex-direction: column; gap: 8px; font-size: 13px; font-weight: 600; color: var(--kimsa-ink); }
  .contact-form__req { color: var(--kimsa-coral); }
  .contact-form__hint { font-weight: 400; font-size: 12px; color: var(--kimsa-ink-soft); }
  .contact-form__field input,
  .contact-form__field textarea {
    font-family: var(--kimsa-font-sans);
    font-size: 15px;
    font-weight: 400;
    color: var(--kimsa-ink);
    background: var(--kimsa-bone);
    border: 1.5px solid var(--kimsa-rule);
    border-radius: var(--kimsa-radius-md);
    padding: 13px 16px;
    resize: vertical;
    transition: border-color var(--kimsa-dur) var(--kimsa-ease);
  }
  .contact-form__field input:focus,
  .contact-form__field textarea:focus {
    outline: none;
    border-color: var(--kimsa-terracotta);
  }
  .contact-form__field :invalid { box-shadow: none; } /* evita el rojo nativo mientras se escribe */
  .contact-form__field input.is-invalid,
  .contact-form__field textarea.is-invalid { border-color: var(--kimsa-coral); }
  .contact-form__error { font-size: 12px; font-weight: 500; color: var(--kimsa-coral); min-height: 14px; }

  .contact-form__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .contact-form__foot { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .contact-form__submit { border: none; }
  .contact-form__submit:disabled { opacity: 0.6; cursor: not-allowed; }
  .contact-form__status { font-size: 14px; font-weight: 500; }
  .contact-form__status--success { color: var(--kimsa-forest); }
  .contact-form__status--error { color: var(--kimsa-coral); }

  @media (max-width: 900px) {
    .contact-form__grid { grid-template-columns: 1fr; gap: 40px; }
    .contact-form__card { padding: 28px; }
    .contact-form__row { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Envío del formulario de contacto por fetch (sin recargar), contra el
  // webhook de n8n. Patrón por querySelectorAll para tolerar que el
  // componente aparezca más de una vez en la página.
  const MIN_MESSAGE_WORDS = 10;
  const wordCount = (str) => (str.match(/\S+/g) || []).length;
  const isValidEmail = (str) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(str);
  const isValidPhone = (str) => str.replace(/[^0-9]/g, '').length >= 7;

  // Reglas de los campos obligatorios: cada una devuelve un mensaje de error
  // (string) o '' si el valor es válido.
  const fieldRules = {
    nombre: (v) => (v.trim() ? '' : 'Por favor indica tu nombre.'),
    email: (v) => {
      const val = v.trim();
      if (!val) return 'Por favor indica tu correo.';
      if (!isValidEmail(val)) return 'Ese correo no parece válido.';
      return '';
    },
    telefono: (v) => {
      const val = v.trim();
      if (!val) return 'Por favor indica un teléfono de contacto.';
      if (!isValidPhone(val)) return 'Ese teléfono no parece válido.';
      return '';
    },
    asunto: (v) => (v.trim() ? '' : 'Por favor indica el asunto de tu mensaje.'),
    mensaje: (v) => {
      const val = v.trim();
      if (!val) return 'Cuéntanos brevemente tu mensaje.';
      if (wordCount(val) < MIN_MESSAGE_WORDS) return `Escribe al menos ${MIN_MESSAGE_WORDS} palabras para que podamos entender tu solicitud.`;
      return '';
    },
  };

  document.querySelectorAll('.contact-form__card').forEach((form) => {
    const endpoint = form.dataset.endpoint;
    const submitBtn = form.querySelector('.contact-form__submit');
    const statusEl = form.querySelector('.contact-form__status');
    const submitLabel = submitBtn ? submitBtn.textContent : 'Enviar mensaje →';

    const setStatus = (type, msg) => {
      if (!statusEl) return;
      statusEl.textContent = msg;
      statusEl.className = 'contact-form__status' + (type ? ` contact-form__status--${type}` : '');
    };

    const clearFieldError = (name) => {
      const input = form.elements.namedItem(name);
      input?.classList.remove('is-invalid');
      const errorEl = form.querySelector(`[data-error-for="${name}"]`);
      if (errorEl) errorEl.textContent = '';
    };

    const validateField = (name) => {
      const input = form.elements.namedItem(name);
      const rule = fieldRules[name];
      if (!input || !rule) return true;
      const msg = rule(input.value);
      input.classList.toggle('is-invalid', !!msg);
      const errorEl = form.querySelector(`[data-error-for="${name}"]`);
      if (errorEl) errorEl.textContent = msg;
      return !msg;
    };

    // Valida en vivo una vez que el usuario ya intentó corregir un campo.
    Object.keys(fieldRules).forEach((name) => {
      const input = form.elements.namedItem(name);
      input?.addEventListener('blur', () => validateField(name));
      input?.addEventListener('input', () => {
        if (input.classList.contains('is-invalid')) validateField(name);
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!endpoint) return;

      // honeypot: si un bot lo rellenó, fingimos éxito y no enviamos nada.
      const honeypot = form.querySelector('[name="sitio_web"]');
      if (honeypot && honeypot.value) {
        form.reset();
        setStatus('success', '¡Gracias! Recibimos tu mensaje y te contactaremos pronto.');
        return;
      }

      const names = Object.keys(fieldRules);
      const results = names.map((name) => validateField(name));
      if (results.includes(false)) {
        const firstInvalid = form.elements.namedItem(names[results.indexOf(false)]);
        firstInvalid?.focus();
        setStatus('error', 'Revisa los campos marcados antes de enviar.');
        return;
      }

      const data = {
        nombre: (form.elements.namedItem('nombre')?.value ?? '').trim(),
        email: (form.elements.namedItem('email')?.value ?? '').trim(),
        telefono: (form.elements.namedItem('telefono')?.value ?? '').trim(),
        asunto: (form.elements.namedItem('asunto')?.value ?? '').trim(),
        mensaje: (form.elements.namedItem('mensaje')?.value ?? '').trim(),
      };

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Enviando…';
      }
      setStatus('', '');

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error(`status ${res.status}`);
        form.reset();
        names.forEach(clearFieldError); // el reset vacía los campos; no re-validar contra vacío
        setStatus('success', '¡Gracias! Recibimos tu mensaje y te contactaremos pronto.');
      } catch (err) {
        setStatus('error', 'Hubo un problema al enviar. Escríbenos directamente a info@kimsa.co.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = submitLabel;
        }
      }
    });
  });
</script>
