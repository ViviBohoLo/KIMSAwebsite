---
/**
 * ProjectsCarousel — carrusel horizontal (con flechas) de proyectos de un
 * servicio. Cada tarjeta abre el ProjectModal (incluir <ProjectModal/> en la
 * página). Recibe la lista de proyectos a mostrar.
 */
import PhotoPlaceholder from '../surfaces/PhotoPlaceholder.astro';
import type { Project } from '../../data/site';
import { AREA_COLOR, localizeCountryName, localizeProject, isClientLogoImage } from '../../data/site';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  projects: Project[];
  id?: string;
}
const { projects, id = 'pc' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const items = projects.map((proj) => localizeProject(proj, lang));
---
<div class="pc" data-carousel={id}>
  <div class="pc__track" id={`${id}-track`}>
    {items.map((p) => (
      <article class="pc__card" data-project={p.slug} tabindex="0" role="button" aria-label={`${lang === 'en' ? 'View' : 'Ver'} ${p.title}`}>
        <div class:list={['pc__media', { 'pc__media--logo': isClientLogoImage(p.image) }]}>
          {p.image
            ? <img src={p.image} alt={p.title} />
            : <PhotoPlaceholder ratio="4/3" tint={p.tint} rounded={0} label={`${localizeCountryName(p.country, lang)} · ${lang === 'en' ? 'project photo' : 'foto de proyecto'}`} />}
        </div>
        <div class="pc__body">
          <span class="pc__loc">{localizeCountryName(p.country, lang)}{p.year ? ` · ${p.year}` : ''}</span>
          <h3 class="pc__title">{p.title}</h3>
          <p class="pc__summary">{p.summary}</p>
          <div class="pc__footer">
            <span class="pc__more" style={`color:${AREA_COLOR[p.area]}; border-color:${AREA_COLOR[p.area]}`}>{t('projects.viewMore')}</span>
            {p.publicationUrl && (
              <a class="pc__pub" href={p.publicationUrl} target="_blank" rel="noopener noreferrer">
                {t('projects.viewPublication')}
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
  <div class="pc__nav">
    <button class="pc__arrow" data-dir="-1" aria-label={t('carousel.prev')}>←</button>
    <button class="pc__arrow" data-dir="1" aria-label={t('carousel.next')}>→</button>
  </div>
</div>

<script>
  document.querySelectorAll('[data-carousel]').forEach((root) => {
    const id = root.getAttribute('data-carousel');
    const track = document.getElementById(id + '-track');
    if (!track) return;
    const step = () => Math.min(track.clientWidth * 0.85, 640);
    root.querySelectorAll('.pc__arrow').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.getAttribute('data-dir'));
        track.scrollBy({ left: dir * step(), behavior: 'smooth' });
      });
    });
    track.querySelectorAll('.pc__card').forEach((c) => {
      c.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); c.click(); }
      });
    });

    // El botón de publicación va dentro de la tarjeta clicable: evitar que su
    // clic también abra el modal del proyecto.
    root.querySelectorAll('.pc__pub').forEach((a) => {
      a.addEventListener('click', (e) => e.stopPropagation());
      a.addEventListener('keydown', (e) => e.stopPropagation());
    });
  });
</script>

<style>
  .pc { position: relative; }
  .pc__track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 8px;
    scrollbar-width: none;
  }
  .pc__track::-webkit-scrollbar { display: none; }
  .pc__card {
    scroll-snap-align: start;
    flex: 0 0 340px;
    max-width: 340px;
    background: var(--kimsa-surface-card);
    border-radius: var(--kimsa-radius-xl);
    box-shadow: var(--kimsa-shadow-card);
    overflow: hidden;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    transition: transform var(--kimsa-dur) var(--kimsa-ease), box-shadow var(--kimsa-dur) var(--kimsa-ease);
  }
  .pc__card:hover { transform: translateY(-4px); box-shadow: var(--kimsa-shadow-lift); }
  .pc__card:focus-visible { outline: 3px solid var(--kimsa-terracotta); outline-offset: 2px; }
  .pc__media :global(img) { width: 100%; aspect-ratio: 4/3; object-fit: cover; }
  /* Logo de cliente como imagen provisional (ver isClientLogoImage en
     data/site.ts): se muestra completo y centrado en vez de recortado. */
  .pc__media--logo { background: var(--kimsa-surface-card); }
  .pc__media--logo :global(img) { object-fit: contain; padding: 24px; }
  /* Portada EC-LEDS: muy horizontal, se ve pequeña con el padding estándar. */
  .pc__media--logo :global(img[src$="ec-leds-alliance-ciat.jpg"]) { padding: 8px; }
  .pc__body { padding: 22px 24px 24px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .pc__loc { font-size: 11px; font-weight: 600; color: var(--kimsa-ink-soft); text-transform: uppercase; letter-spacing: 0.06em; }
  .pc__title { font-weight: 500; font-size: 18px; line-height: 1.3; margin: 0; }
  .pc__summary { font-size: 14px; color: var(--kimsa-ink-soft); line-height: 1.55; margin: 0; }
  .pc__footer { margin-top: auto; padding-top: 10px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .pc__more { display: inline-flex; align-items: center; font-size: 13px; font-weight: 600; border: 1.5px solid; border-radius: var(--kimsa-radius-pill); padding: 7px 15px; }
  .pc__pub {
    display: inline-flex;
    align-items: center;
    font-size: 13px;
    font-weight: 600;
    color: var(--kimsa-bone);
    background: var(--kimsa-terracotta);
    border-radius: var(--kimsa-radius-pill);
    padding: 7px 15px;
    text-decoration: none;
    transition: opacity var(--kimsa-dur) var(--kimsa-ease);
  }
  .pc__pub:hover { opacity: 0.88; }
  .pc__nav { display: flex; gap: 12px; margin-top: 28px; }
  .pc__arrow {
    width: 52px;
    height: 52px;
    border-radius: 999px;
    border: 1.5px solid var(--kimsa-rule);
    background: var(--kimsa-bone);
    color: var(--kimsa-ink);
    font-size: 20px;
    cursor: pointer;
    transition: all var(--kimsa-dur) var(--kimsa-ease);
  }
  .pc__arrow:hover { background: var(--kimsa-terracotta); border-color: var(--kimsa-terracotta); color: var(--kimsa-bone); }

  @media (max-width: 600px) {
    .pc__card { flex-basis: 82%; max-width: 82%; }
  }
</style>
