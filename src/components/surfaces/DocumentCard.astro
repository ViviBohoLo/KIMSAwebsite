---
/**
 * DocumentCard — tarjeta de publicación/documento elaborado por KIMSA:
 * etiqueta de área, título, cliente/aliado, aporte de KIMSA, tags y un botón
 * que enlaza directo al documento (nueva pestaña).
 */
import Button from '../core/Button.astro';
import { AREA_COLOR, areaLabel, localizeDocument } from '../../data/site';
import type { KimsaDocument } from '../../data/site';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  doc: KimsaDocument;
}
const { doc: rawDoc } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const doc = localizeDocument(rawDoc, lang);
const accent = AREA_COLOR[doc.area];
---
<article class="doc-card" id={doc.slug}>
  <div class="doc-card__body">
    <span class="doc-card__tag" style={`color:${accent}; background:color-mix(in srgb, ${accent} 12%, transparent)`}>
      {areaLabel(doc.area, lang)}{doc.year ? ` · ${doc.year}` : ''}
    </span>
    <h3 class="doc-card__title">{doc.title}</h3>
    {doc.client && <p class="doc-card__client">{doc.client}</p>}
    <p class="doc-card__text">{doc.contribution}</p>
    <div class="doc-card__tags">
      {doc.tags.map((tag) => <span class="doc-card__chip">{tag}</span>)}
    </div>
    <div class="doc-card__actions">
      <Button variant="primary" size="sm" href={doc.url} target="_blank" rel="noopener noreferrer">
        {t('doc.view')}
      </Button>
      <Button variant="secondary" size="sm" href={doc.url} target="_blank" rel="noopener noreferrer" download>
        {t('doc.download')}
      </Button>
    </div>
  </div>
</article>

<style>
  .doc-card {
    background: var(--kimsa-surface-card);
    border-radius: var(--kimsa-radius-xl);
    box-shadow: var(--kimsa-shadow-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--kimsa-dur) var(--kimsa-ease), box-shadow var(--kimsa-dur) var(--kimsa-ease);
    scroll-margin-top: 100px;
  }
  .doc-card:hover { transform: translateY(-4px); box-shadow: var(--kimsa-shadow-lift); }
  .doc-card__body { padding: 28px; display: flex; flex-direction: column; gap: 12px; }
  .doc-card__tag { display: inline-block; align-self: flex-start; padding: 5px 12px; font-size: 11px; font-weight: 600; border-radius: 999px; letter-spacing: 0.06em; text-transform: uppercase; }
  .doc-card__title { font-weight: 500; font-size: 21px; margin: 0; line-height: 1.3; }
  .doc-card__client { font-size: 13px; font-weight: 500; color: var(--kimsa-terracotta); margin: 0; }
  .doc-card__text { font-size: 14px; color: var(--kimsa-ink-soft); line-height: 1.6; margin: 0; }
  .doc-card__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .doc-card__chip { font-size: 11px; font-weight: 500; color: var(--kimsa-ink); background: var(--kimsa-cream); border: 1px solid var(--kimsa-rule); border-radius: 999px; padding: 5px 10px; }
  .doc-card__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
</style>
