---
/**
 * NumberedCard — tarjeta de capacidad con degradado tenue (mismo tratamiento
 * que ValueCard en Home, no color plano) y punto de acento antes del título
 * (antes llevaba un disco numerado 01, 02… — retirado: las listas que la
 * usan son ofertas paralelas, no una secuencia real).
 */
interface Props {
  title: string;
  accent?: string;
  tint?: string;
  class?: string;
}
const {
  title,
  accent = 'var(--kimsa-forest)',
  tint = 'var(--kimsa-tint-forest)',
  class: className,
} = Astro.props;
---
<div
  class:list={['numbered-card', className]}
  style={`background:linear-gradient(160deg, ${tint} 0%, color-mix(in srgb, ${tint} 55%, white) 100%);`}
>
  <h3 class="numbered-card__title" style={`color:${accent};`}><span class="dot" style={`background:${accent};`}></span>{title}</h3>
  <p class="numbered-card__body"><slot /></p>
</div>

<style>
  .numbered-card {
    border-radius: var(--kimsa-radius-xl);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 200px;
  }
  .numbered-card__title { font-weight: 600; font-size: 22px; margin: 0; line-height: 1.25; display: flex; align-items: center; gap: 10px; }
  .numbered-card__title .dot { width: 8px; height: 8px; border-radius: 999px; flex-shrink: 0; }
  .numbered-card__body {
    font-size: 14px;
    color: var(--kimsa-ink);
    line-height: 1.55;
    margin: 0;
    opacity: 0.78;
  }
  @media (max-width: 900px) { .numbered-card { min-height: 0; } }
</style>
