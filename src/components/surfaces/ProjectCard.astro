---
/**
 * ProjectCard — tarjeta de proyecto: foto (placeholder), etiqueta país/año,
 * título, cliente y resumen. Usada en Proyectos y en referencias de servicio.
 */
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import type { Project } from '../../data/site';

interface Props {
  project: Project;
  accent?: string;
  detailed?: boolean; // muestra la descripción completa + tags
}
const { project, accent = 'var(--kimsa-forest)', detailed = false } = Astro.props;
---
<article class="proj-card" id={project.slug}>
  <PhotoPlaceholder ratio="4/3" tint={project.tint} rounded={0} label={`${project.country} · foto de proyecto`} />
  <div class="proj-card__body">
    <span class="proj-card__tag" style={`color:${accent}; background:color-mix(in srgb, ${accent} 12%, transparent)`}>
      {project.country}{project.year ? ` · ${project.year}` : ''}
    </span>
    <h3 class="proj-card__title">{project.title}</h3>
    <p class="proj-card__client">{project.client}</p>
    <p class="proj-card__text">{detailed ? project.description : project.summary}</p>
    {detailed && (
      <div class="proj-card__tags">
        {project.tags.map((t) => <span class="proj-card__chip">{t}</span>)}
      </div>
    )}
  </div>
</article>

<style>
  .proj-card {
    background: var(--kimsa-surface-card);
    border-radius: var(--kimsa-radius-xl);
    box-shadow: var(--kimsa-shadow-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--kimsa-dur) var(--kimsa-ease), box-shadow var(--kimsa-dur) var(--kimsa-ease);
    scroll-margin-top: 100px;
  }
  .proj-card:hover { transform: translateY(-4px); box-shadow: var(--kimsa-shadow-lift); }
  .proj-card__body { padding: 28px; display: flex; flex-direction: column; gap: 12px; }
  .proj-card__tag { display: inline-block; align-self: flex-start; padding: 5px 12px; font-size: 11px; font-weight: 600; border-radius: 999px; letter-spacing: 0.06em; text-transform: uppercase; }
  .proj-card__title { font-weight: 500; font-size: 21px; margin: 0; line-height: 1.3; }
  .proj-card__client { font-size: 13px; font-weight: 500; color: var(--kimsa-terracotta); margin: 0; }
  .proj-card__text { font-size: 14px; color: var(--kimsa-ink-soft); line-height: 1.6; margin: 0; }
  .proj-card__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .proj-card__chip { font-size: 11px; font-weight: 500; color: var(--kimsa-ink); background: var(--kimsa-cream); border: 1px solid var(--kimsa-rule); border-radius: 999px; padding: 5px 10px; }
</style>
