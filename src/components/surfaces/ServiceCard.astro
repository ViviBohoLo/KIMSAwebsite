---
/**
 * ServiceCard — tarjeta con foto arriba, título, descripción, chips de
 * sub-temas y link. Fondo claro, con una franja superior del color del
 * servicio como acento (forest / terracota / ciruela). Sin degradado de
 * color plano ni glow — la foto manda, la jerarquía la da el tipo.
 * Sin numeración (los tres servicios son paralelos, no una secuencia).
 */
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import { getLangFromUrl } from '../../i18n/utils';

interface Props {
  name: string;
  description: string;
  bullets?: string[];
  bg?: string;
  accent?: string;
  photo?: { src?: string; tint?: string; label?: string };
  /** Logo de marca (fondo claro, propio) en vez de foto — se muestra
   * completo (object-fit: contain) sobre una ficha clara. */
  logo?: string;
  linkLabel?: string;
  href?: string;
}
const lang = getLangFromUrl(Astro.url);
const {
  name,
  description,
  bullets = [],
  bg = 'var(--kimsa-forest)',
  photo,
  logo,
  linkLabel = lang === 'en' ? 'Learn more' : 'Conocer más',
  href = '#',
} = Astro.props;
---
<article class="service-card" style={`--c:${bg};`}>
  {logo ? (
    <div class="service-card__media service-card__media--logo">
      <img src={logo} alt={`Logo ${name}`} />
    </div>
  ) : (
    <div class="service-card__media">
      <PhotoPlaceholder fill rounded={0} src={photo?.src} tint={photo?.tint} label={photo?.label} alt={name} />
    </div>
  )}
  <div class="service-card__body">
    <h3 class="service-card__title">{name}</h3>
    <p class="service-card__desc">{description}</p>
    {bullets.length > 0 && (
      <div class="service-card__tags">
        {bullets.map((b) => <span class="service-card__tag">{b}</span>)}
      </div>
    )}
    <a class="service-card__link" href={href}>{linkLabel}</a>
  </div>
</article>

<style>
  .service-card {
    background: var(--kimsa-surface-card);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: var(--kimsa-shadow-card);
    display: flex;
    flex-direction: column;
    transition: transform var(--kimsa-dur) var(--kimsa-ease), box-shadow var(--kimsa-dur) var(--kimsa-ease);
  }
  .service-card:hover { transform: translateY(-4px); box-shadow: var(--kimsa-shadow-lift); }

  .service-card__media { aspect-ratio: 4 / 3; overflow: hidden; }
  .service-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--kimsa-seam-ease);
  }
  .service-card:hover .service-card__media :global(img) { transform: scale(1.05); }
  .service-card__media--logo {
    background: var(--kimsa-bone);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px;
  }
  .service-card__media--logo img { width: 100%; height: 100%; object-fit: contain; transition: none; }

  .service-card__body {
    padding: 26px 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    border-top: 4px solid var(--c);
  }
  .service-card__title { font-weight: 500; font-size: 22px; color: var(--kimsa-ink); margin: 0; line-height: 1.2; }
  .service-card__desc { font-size: 14.5px; color: var(--kimsa-ink-soft); line-height: 1.55; margin: 0; flex: 1; }
  .service-card__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .service-card__tag {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 10%, white);
    border-radius: 999px;
    padding: 5px 11px;
  }
  .service-card__link {
    margin-top: 2px;
    font-weight: 600;
    font-size: 14px;
    color: var(--c);
    border-bottom: 1.5px solid var(--c);
    padding-bottom: 2px;
    align-self: flex-start;
    transition: opacity var(--kimsa-dur) var(--kimsa-ease);
  }
  .service-card__link:hover { opacity: 0.7; }
</style>
