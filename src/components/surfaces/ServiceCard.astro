---
/**
 * ServiceCard — tarjeta con degradado tenue (no color plano) foto, título,
 * descripción, chips de sub-temas y link "Conocer más", en crema sobre un
 * color de marca. La grilla de servicios usa forest / terracota / ciruela.
 * Sin numeración (los tres servicios son paralelos, no una secuencia) ni
 * eyebrow — un punto de acento antes del título alcanza.
 */
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import Tag from '../core/Tag.astro';
import { getLangFromUrl } from '../../i18n/utils';

interface Props {
  name: string;
  description: string;
  bullets?: string[];
  bg?: string;
  accent?: string;
  photo?: { src?: string; tint?: string; label?: string };
  /** Logo de marca (fondo claro, propio) en vez de foto — se muestra
   * completo (object-fit: contain) sobre una ficha clara, no recortado
   * como una foto. Úsese para marcas como CarbonBox en vez de `photo`. */
  logo?: string;
  linkLabel?: string;
  href?: string;
}
const lang = getLangFromUrl(Astro.url);
const {
  name,
  description,
  bullets = [],
  bg = 'var(--kimsa-forest)',
  accent = 'var(--kimsa-peach)',
  photo,
  logo,
  linkLabel = lang === 'en' ? 'Learn more →' : 'Conocer más →',
  href = '#',
} = Astro.props;
---
<div class="service-card" style={`background:linear-gradient(165deg, ${bg} 0%, color-mix(in srgb, ${bg} 68%, black) 100%);`}>
  <div class="glow" style={`--glow-color: color-mix(in srgb, ${bg} 45%, white); --glow-size: 300px; --glow-top: -90px; --glow-right: -70px;`}></div>
  <div class="service-card__content">
    {logo ? (
      <div class="service-card__logo">
        <img src={logo} alt={`Logo ${name}`} />
      </div>
    ) : photo && (
      <PhotoPlaceholder ratio="4/3" rounded={20} src={photo.src} tint={photo.tint} label={photo.label} />
    )}
    <h3 class="service-card__title"><span class="dot" style={`background:${accent};`}></span>{name}</h3>
    <p class="service-card__desc">{description}</p>
    {bullets.length > 0 && (
      <div class="service-card__tags">
        {bullets.map((b) => <Tag onColor>{b}</Tag>)}
      </div>
    )}
    <a class="service-card__link" href={href} style={`color:${accent};`}>{linkLabel}</a>
  </div>
</div>

<style>
  .service-card {
    color: var(--kimsa-bone);
    border-radius: var(--kimsa-radius-2xl);
    padding: 28px;
    position: relative;
    overflow: hidden;
    transition: transform var(--kimsa-dur) var(--kimsa-ease), box-shadow var(--kimsa-dur) var(--kimsa-ease);
  }
  .service-card:hover { transform: translateY(-4px); box-shadow: var(--kimsa-shadow-lift); }
  .service-card__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .service-card__logo {
    aspect-ratio: 4/3;
    border-radius: var(--kimsa-radius-lg);
    background: var(--kimsa-bone);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .service-card__logo img { width: 100%; height: 100%; object-fit: contain; }
  .service-card__title {
    font-weight: 500;
    font-size: 28px;
    color: var(--kimsa-bone);
    margin: 0;
    line-height: 1.2;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .service-card__title .dot { width: 9px; height: 9px; border-radius: 999px; flex-shrink: 0; }
  .service-card__desc {
    font-size: 15px;
    line-height: 1.55;
    color: rgba(251, 248, 241, 0.85);
    margin: 0;
  }
  .service-card__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .service-card__link {
    margin-top: 8px;
    font-weight: 600;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
</style>
