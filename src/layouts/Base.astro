---
import '../styles/global.css';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}
const lang = getLangFromUrl(Astro.url);
const {
  title = lang === 'en' ? 'KIMSA · Climate · Conservation · Development' : 'KIMSA · Clima · Conservación · Desarrollo',
  description = lang === 'en'
    ? 'KIMSA is a Latin American climate consultancy. We design solutions so nature and people can talk to each other again — no encyclopedias.'
    : 'KIMSA es una consultora climática latinoamericana. Diseñamos soluciones para que la naturaleza y las personas vuelvan a hablarse — sin hacer enciclopedias.',
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Marca que hay JS cuanto antes (evita parpadeo en las animaciones de scroll). -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href="/assets/kimsa-mark.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/kimsa-logo-full.png" />
    <meta property="og:locale" content="es_CO" />
    <meta name="theme-color" content="#1f4d3a" />
  </head>
  <body>
    <!--
      THESIS: Refuses the eyebrow/equal-card "AI-generic NGO" look; owns one
      continuous diffused gradient flow per surface (never a hard section
      cut) as KIMSA's structural signature — confirmed with the user after
      an initial flat color-blocked pass read as disharmonious.
      OWN-WORLD: Existing tokens only — bosque→terracota→coral as one
      unbroken gradient per surface, soft blurred .glow accents, no seams
      or hard color boundaries; Quicksand display type, JetBrains Mono for
      stat/data labels; letter-roll nav hover (toroto-derived); odometer-
      roll stat counters (anewclimate-derived).
      STORY: A ministry/multilateral evaluator sees institutional confidence
      and a distinctly Latin American craft grammar in one scroll, trusts
      KIMSA's technical rigor, and reaches the contact form.
      FIRST VIEWPORT: One hero section, one gradient (forest-deep → forest
      → terracotta → coral) — headline+CTA in the upper/green portion, four
      odometer counters (150+ clientes, 12+ gobiernos, 8,000+ actores,
      1,200+ colaboradores) sitting in the lower/warm portion, no visible
      seam between them.
      FORM: "Trama Andina" — grounded direction #6 of 7, seed key 42d31e18,
      revised twice at user request: flat bands → gradient bands → one
      continuous gradient.
      FINISH: unreviewed and undocumented is unfinished; this build ends
      with the finish review, the verdict, and DESIGN.md.
    -->
    <slot />

    <script>
      // Aparición suave de secciones al hacer scroll (respeta reduce-motion).
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          // threshold 0: basta con que 1px del elemento entre en la ventana
          // reducida (rootMargin) para revelarlo. Con un threshold en % del
          // área total (ej. 0.05) un bloque muy alto —como la cuadrícula de
          // /proyectos con 58+ tarjetas— nunca llega a cubrir ese porcentaje
          // de su propia altura en pantalla y queda invisible para siempre
          // (bug real detectado ago-2026: la grilla de proyectos no aparecía).
          { rootMargin: '0px 0px -10% 0px', threshold: 0 }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
