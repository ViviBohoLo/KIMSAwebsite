---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'KIMSA · Clima · Conservación · Desarrollo',
  description = 'KIMSA es una consultora climática latinoamericana. Diseñamos soluciones para que la naturaleza y las personas vuelvan a hablarse — sin hacer enciclopedias.',
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Marca que hay JS cuanto antes (evita parpadeo en las animaciones de scroll). -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href="/assets/kimsa-mark.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/kimsa-logo-full.png" />
    <meta property="og:locale" content="es_CO" />
    <meta name="theme-color" content="#1f4d3a" />
  </head>
  <body>
    <slot />

    <script>
      // Aparición suave de secciones al hacer scroll (respeta reduce-motion).
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
