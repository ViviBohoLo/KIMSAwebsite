---
/**
 * /clientes — grilla con todas las organizaciones que confían en KIMSA
 * (CLIENT_LOGOS). Cada tarjeta enlaza a /proyectos ya filtrada por los
 * proyectos exactos de esa organización (por slug, vía projectsForClientLogo
 * — ver src/data/site.ts), reutilizando la grilla/filtros de Proyectos en
 * vez de duplicar la información del proyecto acá. Tarjetas de alto
 * uniforme siempre (no hay contenido variable que expandir en esta página).
 */
import Base from '../layouts/Base.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/core/Button.astro';
import { CLIENT_LOGOS, projectsForClientLogo } from '../data/site';

const clients = CLIENT_LOGOS.map((logo) => ({
  logo,
  projects: projectsForClientLogo(logo),
}));
---
<Base
  title="Clientes y aliados · KIMSA"
  description="Organizaciones, gobiernos y empresas que han confiado en KIMSA para gestión climática, psicología ambiental y CarbonBox en América Latina."
>
  <section class="cl-hero">
    <Nav />
    <div class="container cl-hero__inner reveal">
      <nav class="cl-hero__crumb" aria-label="Ruta"><a href="/">Inicio</a> / <span class="current">Clientes</span></nav>
      <h1 class="cl-hero__title">Organizaciones que <em class="em-forest">confían en KIMSA.</em></h1>
      <p class="cl-hero__lead">
        {CLIENT_LOGOS.length} organizaciones, gobiernos y empresas en América Latina. Haga clic en una
        organización para ver sus proyectos realizados con KIMSA.
      </p>
    </div>
  </section>

  <section class="section" style="background:var(--kimsa-cream-deep)">
    <div class="container">
      <div class="cl-grid reveal">
        {clients.map(({ logo, projects }) => {
          const hasProjects = projects.length > 0;
          const href = hasProjects
            ? `/proyectos?slugs=${projects.map((p) => p.slug).join(',')}&client=${encodeURIComponent(logo.alt)}`
            : undefined;
          const Tag = hasProjects ? 'a' : 'div';
          return (
            <Tag class="cl-card" href={href}>
              <div class="cl-card__logo"><img src={logo.src} alt={logo.alt} loading="lazy" /></div>
              <h3 class="cl-card__name">{logo.alt}</h3>
              <p class="cl-card__count">
                {hasProjects
                  ? `${projects.length} proyecto${projects.length > 1 ? 's' : ''} →`
                  : 'Aliado de KIMSA'}
              </p>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA contacto -->
  <section class="section" style="background:var(--kimsa-forest); color:var(--kimsa-bone)">
    <div class="container cl-cta reveal">
      <h2 class="h2" style="color:var(--kimsa-bone); margin-bottom:20px">
        ¿Su organización quiere ser la <em class="em-peach">próxima?</em>
      </h2>
      <p style="font-size:18px; color:rgba(251,248,241,0.85); max-width:560px; margin-bottom:32px">
        Conversemos sobre el reto climático que enfrenta.
      </p>
      <Button variant="primary" size="lg" href="/contacto">Conversemos →</Button>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .cl-hero { position: relative; background: linear-gradient(180deg, var(--kimsa-bone) 0%, rgba(246,208,194,0.5) 100%); padding-bottom: 72px; }
  .cl-hero__inner { padding-top: 8px; }
  .cl-hero__crumb { font-size: 13px; color: var(--kimsa-ink-soft); margin: 108px 0 48px; }
  .cl-hero__crumb a:hover { color: var(--kimsa-terracotta); }
  .cl-hero__crumb .current { color: var(--kimsa-terracotta); font-weight: 600; }
  .cl-hero__title { font-weight: 300; font-size: 64px; line-height: 1.05; letter-spacing: -0.025em; margin: 20px 0 24px; max-width: 820px; }
  .cl-hero__lead { font-size: 19px; line-height: 1.55; color: var(--kimsa-ink-soft); max-width: 620px; }

  .cl-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 18px; }

  .cl-card {
    background: var(--kimsa-surface-card);
    border-radius: var(--kimsa-radius-xl);
    box-shadow: var(--kimsa-shadow-card);
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: transform var(--kimsa-dur) var(--kimsa-ease), box-shadow var(--kimsa-dur) var(--kimsa-ease);
  }
  a.cl-card { cursor: pointer; }
  a.cl-card:hover { transform: translateY(-4px); box-shadow: var(--kimsa-shadow-lift); }

  .cl-card__logo { width: 100%; height: 60px; display: flex; align-items: center; justify-content: center; background: #fff; border-radius: var(--kimsa-radius-sm); padding: 8px 12px; }
  .cl-card__logo img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .cl-card__name { font-weight: 600; font-size: 13.5px; margin: 0; line-height: 1.3; min-height: 2.6em; display: flex; align-items: center; }
  .cl-card__count { font-size: 12px; font-weight: 600; color: var(--kimsa-terracotta); margin: 0; }
  div.cl-card .cl-card__count { color: var(--kimsa-ink-soft); font-weight: 500; }

  .cl-cta { text-align: center; display: flex; flex-direction: column; align-items: center; }

  @media (max-width: 1100px) { .cl-grid { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 780px) {
    .cl-hero__inner { padding-left: 24px; padding-right: 24px; }
    .cl-hero__title { font-size: 42px; }
    .cl-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 480px) {
    .cl-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
