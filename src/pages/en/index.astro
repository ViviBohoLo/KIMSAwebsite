---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/layout/Nav.astro';
import Footer from '../../components/layout/Footer.astro';
import Button from '../../components/core/Button.astro';
import MountainMark from '../../components/brand/MountainMark.astro';
import PhotoPlaceholder from '../../components/surfaces/PhotoPlaceholder.astro';
import ClientsMarquee from '../../components/sections/ClientsMarquee.astro';
import ValueCard from '../../components/surfaces/ValueCard.astro';
import ServiceCard from '../../components/surfaces/ServiceCard.astro';
import Card from '../../components/surfaces/Card.astro';
import CourseCTA from '../../components/sections/CourseCTA.astro';
import ContactForm from '../../components/sections/ContactForm.astro';
import ProjectModal from '../../components/sections/ProjectModal.astro';
import OdometerStat from '../../components/core/OdometerStat.astro';
import HomeSectionNav from '../../components/sections/HomeSectionNav.astro';
import PresenceMap from '../../components/sections/PresenceMap.astro';
import { PROJECTS, TEAM, CONTACT, CLIENT_LOGOS, localizeProject, localizeMember, localizeCountryName } from '../../data/site';

const values = [
  { t: 'Less is more', d: 'We simplify the most complex problems. Our results are brief, understandable, and useful.', fg: 'var(--kimsa-forest)', bg: 'var(--kimsa-tint-forest)' },
  { t: 'Creative people', d: 'A fresh, neutral, and innovative approach to finding conscious development solutions.', fg: 'var(--kimsa-terracotta)', bg: 'var(--kimsa-tint-terracotta)' },
  { t: 'Your processes, our goal', d: 'We work hand in hand with clients to ensure applicability and continuity.', fg: 'var(--kimsa-coral)', bg: 'var(--kimsa-tint-coral)' },
];

const services = [
  { name: 'Climate Management', description: 'We measure, plan, and transform processes to reduce emissions and adapt to climate change.', bullets: ['GHG inventories', 'MRV systems', 'Adaptation', 'NDC'], bg: 'var(--kimsa-forest)', accent: 'var(--kimsa-peach)', photo: { src: '/assets/projects/taller-gestion-climatica-home.jpg', tint: 'forest', label: 'work session · climate management' }, href: '/en/servicios/gestion-climatica' },
  { name: 'Environmental Psychology', description: 'We integrate social, cultural, and emotional approaches to co-create climate solutions with communities.', bullets: ['Behavior change', 'Participation', 'Gender and inclusion'], bg: 'var(--kimsa-terracotta)', accent: '#ffd9b8', photo: { src: '/assets/projects/psicologia-ambiental-home.jpg', tint: 'sunset', label: 'community gathering · environmental psychology' }, href: '/en/servicios/psicologia-ambiental' },
  { name: 'CarbonBox', description: 'Technology for nature: we measure, manage, and decarbonize the environmental footprints of companies and organizations.', bullets: ['Carbon footprint', 'ISO 14064', 'ISO 14067', 'GHG Protocol', 'Reduction management', 'Carbon neutrality'], bg: 'var(--kimsa-plum)', accent: 'var(--kimsa-peach)', photo: { src: '/assets/projects/carbonbox-platform.jpg', tint: 'dusk', label: 'CarbonBox team' }, href: '/en/servicios/carbonbox' },
];

const stats = [
  { n: '+150', l: 'projects in Latin America', fg: 'var(--kimsa-terracotta)', bg: 'var(--kimsa-blush)' },
  { n: '+12', l: 'governments supported under the Paris Agreement', fg: 'var(--kimsa-forest)', bg: 'var(--kimsa-tint-forest)' },
  { n: '+8,000', l: 'people consulted', fg: 'var(--kimsa-coral)', bg: 'var(--kimsa-tint-coral)' },
  { n: '+1,200', l: 'people trained', fg: 'var(--kimsa-gold)', bg: 'var(--kimsa-tint-gold)' },
];
// Mismas cifras que arriba, partidas en prefijo/valor numérico para el
// contador tipo odómetro del hero (ver OdometerStat).
const heroStats = stats.map((s) => {
  const m = s.n.match(/^(\D*)(.*)$/);
  return { prefix: m?.[1] ?? '', value: m?.[2] ?? s.n, l: s.l };
});

const story = [
  { y: '2017', t: 'KIMSA is born', d: 'Founded in Bogotá with a Latin American vocation.' },
  { y: '2020', t: 'LATAM expansion', d: 'Expansion and support for projects in several Latin American countries.' },
  { y: '2020', t: 'Alliance with the InnNature Foundation', d: '1% of our profits support the conservation of the Ceiba Bruja Reserve.' },
  { y: '2022', t: 'CarbonBox launch', d: 'Our platform to measure and manage footprints.' },
  { y: '2024', t: 'Company of the Year', d: 'Recognized by the Bogotá Chamber of Commerce.' },
];

const bySlug = (s: string) => PROJECTS.find((p) => p.slug === s)!;
const featured = localizeProject(bySlug('ndc-3-el-salvador'), 'en');
// Una muestra por área para la Home (el listado completo está en /en/proyectos)
const secondary = ['mrv-ecuador', 'sostenibilidad-dnp-colombia', 'cluster-solnatura'].map((s) => localizeProject(bySlug(s), 'en'));
const team = TEAM.map((m) => localizeMember(m, 'en'));
---
<Base>
  <HomeSectionNav />

  <!-- ============ HERO ============ -->
  <section class="hero" id="inicio" data-nav-theme="dark">
    <video class="hero__video" autoplay muted loop playsinline aria-hidden="true">
      <source src="/assets/videos/Hero.mp4" type="video/mp4" />
    </video>
    <div class="hero__overlay" aria-hidden="true"></div>
    <Nav overlay />
    <div class="hero__glow hero__glow--peach" aria-hidden="true"></div>
    <div class="hero__glow hero__glow--terracotta" aria-hidden="true"></div>

    <div class="hero-band__grid container">
      <h1 class="hero-band__title">
        We design solutions so nature and people <em class="em-peach">can talk to each other again.</em>
      </h1>
      <div class="hero-band__side">
        <p class="hero-band__lead">
          We are KIMSA. A young climate consultancy, born in Bogotá in 2017, working
          from 8 Latin American countries to tackle the climate crisis with rigor,
          freshness, and humanity.
        </p>
        <Button variant="primary" href="#servicios" class="hero-band__cta">See our work →</Button>
      </div>
    </div>

    <div class="hero-stats__row container">
      {heroStats.map((s) => (
        <OdometerStat value={s.value} prefix={s.prefix} label={s.l} accent="var(--kimsa-bone)" labelChip />
      ))}
    </div>
  </section>

  <!-- ============ CLIENTES ============ -->
  <section class="section clients">
    <div class="clients__head reveal">
      <MountainMark size={44} class="clients__mark" />
      <p class="clients__statement">Trusted by {CLIENT_LOGOS.length} organizations in 8 countries</p>
    </div>
    <div class="clients__marquee reveal">
      <ClientsMarquee />
    </div>
    <div class="clients__cta reveal">
      <Button variant="secondary" size="sm" href="/en/clientes">See all the organizations that trust KIMSA →</Button>
    </div>
  </section>

  <!-- ============ MANIFIESTO / PROPÓSITO ============ -->
  <section class="section manifesto">
    <div class="blob blob--peach" style="top:-100px; right:-100px;"></div>
    <div class="blob blob--sage" style="bottom:-50px; left:-150px;"></div>
    <div class="manifesto__mark"><MountainMark size={320} /></div>
    <div class="manifesto__grid container">
      <div class="reveal manifesto__label">
        <MountainMark size={72} />
        <span class="side-tag">Our purpose</span>
      </div>
      <div>
        <h2 class="h2-lg reveal">
          We create <em class="em-forest">useful, replicable, and innovative products and
          solutions</em> that <em class="em-terracotta">transform society</em> — no encyclopedias.
        </h2>
        <div class="manifesto__values reveal">
          {values.map((v) => <ValueCard title={v.t} accent={v.fg} tint={v.bg}>{v.d}</ValueCard>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SERVICIOS ============ -->
  <section class="section services" id="servicios">
    <div class="services__head container">
      <div class="reveal services__head-left">
        <span class="side-tag">What we do</span>
        <h2 class="h2">Three paths, one <em class="em-forest">compass.</em></h2>
      </div>
      <p class="lead reveal">
        We work alongside companies, governments, and communities with humanity,
        creativity, and innovation. Each project adapts to its own context and pace.
      </p>
    </div>
    <div class="services__grid container reveal">
      {services.map((s) => <ServiceCard {...s} />)}
    </div>
  </section>

  <!-- ============ IMPACTO ============ -->
  <section class="section impact">
    <div class="blob blob--peach" style="top:-80px; left:-80px;"></div>
    <div class="impact__grid container">
      <div class="reveal impact__head">
        <span class="side-tag">What we sow</span>
        <h2 class="h2-lg">Work that leaves a <em class="em-forest">mark.</em></h2>
      </div>
      <p class="impact__text reveal">
        Since 2017 we've worked with companies, governments, and communities
        across Latin America — a steady path the Bogotá Chamber of Commerce
        recognized as Company of the Year 2024.
      </p>
      <div class="impact__badge reveal">
        <img src="/assets/kimsa-camara.png" alt="Bogotá Chamber of Commerce" />
        <div>
          <div class="impact__badge-title">Company of the Year 2024</div>
          <div class="impact__badge-sub">Recognized by the Bogotá Chamber of Commerce</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CEIBA BRUJA / CONSERVACIÓN ============ -->
  <section class="section ceiba" id="ceiba" data-nav-theme="dark">
    <div class="blob blob--terracotta" style="top:-100px; right:-100px; width:500px; height:500px;"></div>
    <div class="ceiba__grid container">
      <PhotoPlaceholder class="reveal" src="/assets/projects/ceiba.jpg" alt="Ceiba Bruja Reserve" ratio="4/3" tint="earth" rounded={32} label="ceiba bruja reserve · tropical dry forest · sierra nevada" />
      <div class="reveal">
        <div class="ceiba__head">
          <span class="side-tag" style="color:var(--kimsa-peach)">Our contribution to nature</span>
          <h2 class="h2" style="color:var(--kimsa-bone)">
            <em class="em-peach">1%</em> of our profits go to the
            <a class="em-peach ceiba__link" href="https://www.innnature.org/" target="_blank" rel="noopener noreferrer">Ceiba Bruja Reserve</a>,
            in the Sierra Nevada de Santa Marta.
          </h2>
        </div>
        <p class="ceiba__text">
          Since 2020 we've had an alliance with the <a class="em-peach ceiba__link" href="https://www.innnature.org/" target="_blank" rel="noopener noreferrer">InnNature Foundation</a>,
          working together on the conservation of tropical dry forest and supporting
          sustainable productive projects for local communities.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ PROYECTOS ============ -->
  <section class="section projects" id="proyectos-home">
    <div class="projects__head container">
      <div class="reveal projects__head-left">
        <span class="side-tag">Our work</span>
        <h2 class="h2">Projects that leave a <em class="em-forest">mark.</em></h2>
      </div>
      <Button variant="ghost" href="/en/proyectos" class="reveal">See all projects →</Button>
    </div>
    <div class="projects__grid container">
      <Card padded={false} class="reveal projects__featured" data-project={featured.slug} role="button" tabindex="0" aria-label={`View ${featured.title}`}>
        <PhotoPlaceholder ratio="16/10" src={featured.image} alt={featured.title} tint={featured.tint} rounded={0} label={`featured project · ${localizeCountryName(featured.country, 'en')}`} />
        <div class="projects__featured-body">
          <span class="projects__badge">Featured project · {localizeCountryName(featured.country, 'en')}</span>
          <h3 class="projects__featured-title">{featured.title}</h3>
          <p class="projects__featured-desc">{featured.summary}</p>
          <div class="projects__tags">
            {featured.tags.map((t) => <span class="projects__tag">{t}</span>)}
          </div>
        </div>
      </Card>
      <div class="projects__col">
        {secondary.map((p) => (
          <div class="reveal projects__small" data-project={p.slug} role="button" tabindex="0" aria-label={`View ${p.title}`}>
            <PhotoPlaceholder fill src={p.image} alt={p.title} tint={p.tint} rounded={0} label={localizeCountryName(p.country, 'en')} />
            <div class="projects__small-body">
              <div class="projects__small-tag">{localizeCountryName(p.country, 'en')}{p.year ? ` · ${p.year}` : ''}</div>
              <h3 class="projects__small-title">{p.title}</h3>
              <p class="projects__small-desc">{p.client}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ NUESTRA HISTORIA ============ -->
  <section class="section story" data-nav-theme="dark">
    <div class="story__mark"><MountainMark size={360} mono="rgba(255,255,255,0.9)" /></div>
    <div class="story__grid container">
      <div class="reveal">
        <div class="story__head">
          <span class="side-tag" style="color:var(--kimsa-peach)">Our story</span>
          <h2 class="h2" style="color:var(--kimsa-bone)">
            Since 2017, connecting <em class="em-peach">nature, people, and systems.</em>
          </h2>
        </div>
        <p class="story__text">
          We believe in conscious development. We design solutions that are
          useful, replicable, and aligned with the Sustainable Development
          Goals — no encyclopedias.
        </p>
      </div>
      <div class="reveal">
        {story.map((s) => (
          <div class="story__item">
            <div class="story__year">{s.y}</div>
            <div>
              <div class="story__item-title">{s.t}</div>
              <div class="story__item-desc">{s.d}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ EQUIPO ============ -->
  <section class="section team" id="equipo">
    <div class="team__grid container">
      <div class="reveal">
        <div class="team__head">
          <span class="side-tag">The people</span>
          <h2 class="h2">A young team, mostly <em class="em-forest">women.</em></h2>
        </div>
        <p class="team__text">
          We work from home, from the field, from wherever life finds us. We
          trust autonomy and celebrate different ways of working.
        </p>
        <div class="team__band">
          <div class="team__band-n">80%</div>
          <div class="team__band-l">of our team is made up of women</div>
        </div>
      </div>
      <div class="team__people reveal">
        {team.map((m) => (
          <div class="team__person">
            <div class="team__photo" style={`background:linear-gradient(165deg, ${m.color} 0%, color-mix(in srgb, ${m.color} 70%, transparent) 60%, var(--kimsa-peach) 130%)`}>
              <img src={m.img} alt={m.name} />
            </div>
            <div class="team__name">{m.name}</div>
            <div class="team__role">{m.role}</div>
          </div>
        ))}
        <div class="team__person">
          <div class="team__photo team__photo--more">
            <span class="team__more-n">+30</span>
            <MountainMark size={40} mono="rgba(255,255,255,0.9)" />
          </div>
          <div class="team__name">+30 professionals</div>
          <div class="team__role">Latin American HUB</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MAPA / PRESENCIA ============ -->
  <section class="section map">
    <PresenceMap variant="home" />
  </section>

  <!-- ============ CURSO (CTA) ============ -->
  <CourseCTA />

  <!-- ============ CONTACTO ============ -->
  <ContactForm variant="home" />

  <Footer />
  <ProjectModal />
</Base>

<style>
  .hero {
    position: relative;
    color: var(--kimsa-bone);
    padding-bottom: 64px;
    overflow: hidden;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg,
      var(--kimsa-forest-deep) 0%,
      var(--kimsa-forest) 58%,
      color-mix(in srgb, var(--kimsa-terracotta) 45%, var(--kimsa-cream) 55%) 85%,
      color-mix(in srgb, var(--kimsa-coral) 35%, var(--kimsa-cream) 65%) 100%);
    opacity: 0.64;
    pointer-events: none;
  }
  .hero-band__grid { position: relative; z-index: 2; padding-top: min(18vh, 210px); }
  .hero__glow {
    position: absolute;
    z-index: 1;
    border-radius: 50%;
    filter: blur(70px);
    pointer-events: none;
  }
  .hero__glow--peach { top: -120px; right: -60px; width: 480px; height: 480px; background: radial-gradient(circle, rgba(245,176,131,0.35) 0%, transparent 70%); }
  .hero__glow--terracotta { bottom: 140px; left: 6%; width: 620px; height: 620px; background: radial-gradient(circle, rgba(245,176,131,0.3) 0%, transparent 70%); }
  .hero-band__grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 72px;
    align-items: end;
    padding-left: 56px;
  }
  .hero-band__title { font-weight: 300; font-size: 84px; line-height: 1.03; letter-spacing: -0.025em; margin: 0; }
  .hero-band__side { display: flex; flex-direction: column; gap: 28px; padding-bottom: 6px; }
  .hero-band__lead { font-size: 17px; line-height: 1.6; color: rgba(251, 248, 241, 0.88); margin: 0; }
  .hero-band__cta { align-self: flex-start; }

  .hero-stats__row {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    margin-top: 88px;
    padding-top: 40px;
    border-top: 1px solid rgba(251, 248, 241, 0.18);
  }

  .clients { background: var(--kimsa-cream); padding-top: 88px; padding-bottom: 88px; }
  .clients__head { display: flex; flex-direction: column; align-items: center; gap: 16px; margin-bottom: 44px; }
  .clients__statement { font-size: 20px; font-weight: 500; color: var(--kimsa-ink); text-align: center; }
  .clients__marquee { margin: 0 calc(-1 * var(--kimsa-section-x)); }
  .clients__cta { display: flex; justify-content: flex-end; margin-top: 32px; }
  @media (min-width: 1240px) {
    .clients__cta { padding-right: 120px; }
  }

  .blob { position: absolute; width: 400px; height: 400px; border-radius: 50%; filter: blur(40px); pointer-events: none; }
  .blob--peach { background: radial-gradient(circle, rgba(245,176,131,0.53) 0%, transparent 70%); }
  .blob--sage { background: radial-gradient(circle, rgba(111,141,107,0.53) 0%, transparent 70%); }
  .blob--terracotta { background: radial-gradient(circle, rgba(217,108,60,0.4) 0%, transparent 70%); filter: blur(60px); }

  .manifesto { background: linear-gradient(180deg, var(--kimsa-bone) 0%, var(--kimsa-blush) 100%); }
  .manifesto__mark { position: absolute; top: 40px; right: 80px; opacity: 0.15; pointer-events: none; }
  .manifesto__grid { display: grid; grid-template-columns: 0.8fr 1.6fr; gap: 80px; position: relative; }
  .manifesto__label { display: flex; align-items: center; gap: 20px; height: fit-content; }
  .manifesto__values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 64px; }

  .services { background: var(--kimsa-bone); }
  .services__head { display: grid; grid-template-columns: 1fr 1.4fr; gap: 80px; margin-bottom: 64px; align-items: end; }
  .services__head-left { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .services__head .lead { max-width: 580px; }
  .services__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: start; }

  .impact { background: var(--kimsa-cream); }
  .impact__grid { max-width: 720px; margin: 0 auto; text-align: center; position: relative; }
  .impact__head { display: flex; flex-direction: column; align-items: center; gap: 16px; margin-bottom: 24px; }
  .impact__text { font-size: 18px; line-height: 1.6; color: var(--kimsa-ink-soft); max-width: 520px; margin: 0 auto; }
  .impact__badge {
    margin: 40px auto 0;
    max-width: 480px;
    padding: 28px 32px;
    background: var(--kimsa-bone);
    border-radius: var(--kimsa-radius-xl);
    border: 2px solid var(--kimsa-peach);
    box-shadow: var(--kimsa-shadow-card);
    display: flex;
    align-items: center;
    gap: 24px;
    text-align: left;
  }
  .impact__badge img { height: 68px; object-fit: contain; flex-shrink: 0; }
  .impact__badge-title { font-weight: 600; font-size: 18px; }
  .impact__badge-sub { font-size: 14px; color: var(--kimsa-ink-soft); margin-top: 2px; }

  .ceiba { background: linear-gradient(135deg, var(--kimsa-forest) 0%, var(--kimsa-forest-deep) 60%, #2d1e3d 100%); color: var(--kimsa-bone); }
  .ceiba__grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 80px; align-items: center; position: relative; }
  .ceiba__head { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-bottom: 32px; }
  .ceiba__text { font-size: 17px; line-height: 1.6; color: rgba(251,248,241,0.85); max-width: 520px; }
  .ceiba__link { text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--kimsa-peach) 55%, transparent); transition: border-color var(--kimsa-dur) var(--kimsa-ease); }
  .ceiba__link:hover { border-color: var(--kimsa-peach); }

  .projects { background: var(--kimsa-cream-deep); }
  .projects__head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 48px; gap: 24px; }
  .projects__head-left { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .projects__grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 20px; align-items: stretch; }
  .projects__featured-body { padding: 36px; }
  .projects__badge { display: inline-block; padding: 5px 12px; background: rgba(31,77,58,0.1); color: var(--kimsa-forest); font-size: 12px; font-weight: 600; border-radius: 999px; letter-spacing: 0.06em; margin-bottom: 16px; }
  .projects__featured-title { font-weight: 500; font-size: 30px; margin: 0 0 12px; line-height: 1.2; }
  .projects__featured-desc { font-size: 16px; color: var(--kimsa-ink-soft); line-height: 1.6; margin: 0 0 20px; }
  .projects__tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .projects__tag { font-size: 12px; font-weight: 500; color: var(--kimsa-forest); background: rgba(31,77,58,0.08); border-radius: 999px; padding: 6px 12px; }
  .projects__col { display: grid; grid-template-rows: repeat(3, 1fr); gap: 20px; }
  .projects__featured { cursor: pointer; }
  .projects__featured:focus-visible, .projects__small:focus-visible { outline: 3px solid var(--kimsa-terracotta); outline-offset: 2px; }
  .projects__small { display: grid; grid-template-columns: 130px 1fr; background: var(--kimsa-surface-card); border-radius: var(--kimsa-radius-xl); box-shadow: var(--kimsa-shadow-card); overflow: hidden; cursor: pointer; transition: transform var(--kimsa-dur) var(--kimsa-ease), box-shadow var(--kimsa-dur) var(--kimsa-ease); }
  .projects__small:hover { transform: translateY(-4px); box-shadow: var(--kimsa-shadow-lift); }
  .projects__small-body { padding: 22px 24px; display: flex; flex-direction: column; justify-content: center; }
  .projects__small-tag { font-size: 11px; font-weight: 600; color: var(--kimsa-terracotta); letter-spacing: 0.06em; margin-bottom: 8px; text-transform: uppercase; }
  .projects__small-title { font-weight: 500; font-size: 17px; margin: 0 0 6px; line-height: 1.25; }
  .projects__small-desc { font-size: 13px; color: var(--kimsa-ink-soft); margin: 0; }

