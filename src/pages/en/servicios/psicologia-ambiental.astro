---
import Base from '../../../layouts/Base.astro';
import Footer from '../../../components/layout/Footer.astro';
import ServiceHero from '../../../components/sections/ServiceHero.astro';
import StatBand from '../../../components/sections/StatBand.astro';
import NumberedCard from '../../../components/surfaces/NumberedCard.astro';
import ProjectsCarousel from '../../../components/sections/ProjectsCarousel.astro';
import ProjectModal from '../../../components/sections/ProjectModal.astro';
import { projectsByArea } from '../../../data/site';
const refs = projectsByArea('psicologia');

const stats = [
  { n: '+70', l: 'stakeholders consulted in creating the cross-sector cluster' },
  { n: '5', l: 'community and ethnic processes (Pacific and Andes)' },
  { n: '4', l: 'specialized topics' },
  { n: '3', l: 'organizational partners' },
];

const areas = [
  { t: 'Participatory platforms', d: 'We design collaborative processes with diverse stakeholders.', fg: 'var(--kimsa-terracotta)', bg: 'var(--kimsa-tint-terracotta)' },
  { t: 'Gender and social inclusion', d: 'We incorporate differentiated approaches for equity.', fg: 'var(--kimsa-plum)', bg: 'var(--kimsa-tint-plum)' },
  { t: 'Monitoring and evaluation', d: 'Qualitative and quantitative measurement of change.', fg: 'var(--kimsa-forest)', bg: 'var(--kimsa-tint-forest)' },
  { t: 'Structured conversations', d: 'We facilitate dialogue between generations and sectors.', fg: 'var(--kimsa-coral)', bg: 'var(--kimsa-tint-coral)' },
  { t: 'Mental health and nature', d: 'We promote emotional wellbeing as a foundation for environmental care.', fg: 'var(--kimsa-gold)', bg: 'var(--kimsa-tint-gold)' },
];

const razones = [
  'Environmental transformations require cultural and emotional change.',
  'Connecting with what we feel mobilizes sustainable decisions.',
  'No technical change is sustained without social ownership.',
];

const herramientas = [
  'Facilitation and participatory methodologies (collective mapping, World Café, design thinking)',
  'Network analysis and collective narrative',
  'Wellbeing and cultural-change indicators',
  'Gender- and territory-sensitive evaluations',
];
---
<Base title="Environmental Psychology · KIMSA" description="We integrate environmental psychology tools to facilitate collective change processes and connect people with nature.">
  <ServiceHero
    crumb="Environmental Psychology"
    titleMain="Environmental"
    titleEm="Psychology"
    emColor="var(--kimsa-terracotta)"
    lead="We awaken and reconnect with our humanity for the balance of the planet and societies."
    photo="/assets/projects/psicologia-ambiental-home.jpg"
    photoTint="sunset"
    photoLabel="community gathering · environmental psychology"
    ctaHref="/en/contacto"
  />

  <StatBand stats={stats} bg="var(--kimsa-terracotta)" />

  <!-- Intro / misión -->
  <section class="section" style="background:var(--kimsa-bone)">
    <div class="container narrow reveal">
      <div class="svc-tag-head">
        <span class="side-tag">Our approach</span>
        <h2 class="h2">
          We facilitate collective change processes with <em class="em-terracotta">deep meaning.</em>
        </h2>
      </div>
      <p class="lead">
        At KIMSA we integrate environmental psychology tools to facilitate collective
        change processes, connect people with nature, and generate sustainable
        actions with deep meaning.
      </p>
    </div>
  </section>

  <!-- Áreas de trabajo -->
  <section class="section" style="background:var(--kimsa-cream)">
    <div class="container">
      <div class="svc-tag-head reveal">
        <span class="side-tag">What we do</span>
        <h2 class="h2">Areas of work.</h2>
      </div>
      <div class="svc-cards reveal">
        {areas.map((a) => (
          <NumberedCard title={a.t} accent={a.fg} tint={a.bg}>{a.d}</NumberedCard>
        ))}
      </div>
    </div>
  </section>

  <!-- Por qué la dimensión psicosocial -->
  <section class="section" style="background:var(--kimsa-forest); color:var(--kimsa-bone)">
    <div class="container">
      <div class="svc-tag-head reveal">
        <span class="side-tag" style="color:var(--kimsa-peach)">Why work on the psychosocial dimension?</span>
        <h2 class="h2" style="color:var(--kimsa-bone)">Three key reasons.</h2>
      </div>
      <div class="reasons reveal">
        {razones.map((r) => (
          <div class="reason">
            <span class="reason__dot"></span>
            <p>{r}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Herramientas -->
  <section class="section" style="background:var(--kimsa-bone)">
    <div class="container">
      <div class="svc-tag-head reveal">
        <span class="side-tag">Tools we use</span>
        <h2 class="h2">Methods to <em class="em-terracotta">mobilize.</em></h2>
      </div>
      <ul class="caps reveal">
        {herramientas.map((h) => (
          <li class="caps__item"><span class="caps__mark">▲</span>{h}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Proyectos destacados -->
  <section class="section" id="casos" style="background:var(--kimsa-cream-deep)">
    <div class="container">
      <div class="svc-tag-head reveal">
        <span class="side-tag">Featured projects</span>
        <h2 class="h2">Where the psychosocial <em class="em-terracotta">leaves a mark.</em></h2>
      </div>
      <p class="lead reveal" style="margin-bottom:40px">Swipe or use the arrows to see them all. Click a project to see the details.</p>
      <ProjectsCarousel projects={refs} id="pc-psico" />
    </div>
  </section>

  <Footer />
  <ProjectModal />
</Base>

<style>
  .narrow { max-width: 820px; }
  .svc-tag-head { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-bottom: 48px; }
  .svc-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .caps { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 4px 48px; max-width: 980px; }
  .caps__item { display: flex; gap: 14px; align-items: flex-start; padding: 20px 0; border-top: 1px solid var(--kimsa-rule); font-size: 17px; line-height: 1.5; }
  .caps__mark { color: var(--kimsa-terracotta); font-size: 13px; margin-top: 5px; }
  .reasons { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .reason { padding: 32px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--kimsa-radius-xl); }
  .reason__dot { display: block; width: 10px; height: 10px; border-radius: 999px; background: var(--kimsa-peach); margin-bottom: 16px; }
  .reason p { font-size: 16px; line-height: 1.55; color: rgba(251,248,241,0.9); margin: 0; }
  .hl-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .hl { background: var(--kimsa-surface-card); border-radius: var(--kimsa-radius-lg); padding: 28px; box-shadow: var(--kimsa-shadow-card); }
  .hl__tag { font-size: 12px; font-weight: 600; color: var(--kimsa-terracotta); margin-bottom: 12px; }
  .hl__title { font-weight: 500; font-size: 19px; margin: 0; line-height: 1.3; }
  @media (max-width: 900px) {
    .svc-cards, .reasons, .hl-grid { grid-template-columns: 1fr; }
    .caps { grid-template-columns: 1fr; }
  }
</style>
