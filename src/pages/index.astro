---
import Base from '../layouts/Base.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/core/Button.astro';
import MountainMark from '../components/brand/MountainMark.astro';
import PhotoPlaceholder from '../components/surfaces/PhotoPlaceholder.astro';
import ClientsMarquee from '../components/sections/ClientsMarquee.astro';
import ValueCard from '../components/surfaces/ValueCard.astro';
import ServiceCard from '../components/surfaces/ServiceCard.astro';
import Card from '../components/surfaces/Card.astro';
import CourseCTA from '../components/sections/CourseCTA.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import ProjectModal from '../components/sections/ProjectModal.astro';
import OdometerStat from '../components/core/OdometerStat.astro';
import HomeSectionNav from '../components/sections/HomeSectionNav.astro';
import PresenceMap from '../components/sections/PresenceMap.astro';
import { PROJECTS, TEAM, CONTACT, CLIENT_LOGOS } from '../data/site';

const values = [
  { t: 'Menos es más', d: 'Hacemos simples los problemas más complejos. Nuestros resultados son breves, entendibles y útiles.', fg: 'var(--kimsa-forest)', bg: 'var(--kimsa-tint-forest)' },
  { t: 'Gente creativa', d: 'Un enfoque fresco, neutral e innovador para encontrar soluciones de desarrollo consciente.', fg: 'var(--kimsa-terracotta)', bg: 'var(--kimsa-tint-terracotta)' },
  { t: 'Sus procesos, nuestro objetivo', d: 'Trabajamos de la mano con los clientes para asegurar aplicabilidad y continuidad.', fg: 'var(--kimsa-coral)', bg: 'var(--kimsa-tint-coral)' },
];

const services = [
  { name: 'Gestión Climática', description: 'Medimos, planeamos y transformamos procesos para reducir emisiones y adaptarnos al cambio climático.', bullets: ['Inventarios GEI', 'Sistemas MRV', 'Adaptación', 'NDC'], bg: 'var(--kimsa-forest)', accent: 'var(--kimsa-peach)', photo: { src: '/assets/projects/taller-gestion-climatica-home.jpg', tint: 'forest', label: 'taller de trabajo · gestión climática' }, href: '/servicios/gestion-climatica' },
  { name: 'Psicología Ambiental', description: 'Integramos enfoques sociales, culturales y emocionales para co-crear soluciones climáticas con las comunidades.', bullets: ['Cambio de comportamiento', 'Participación', 'Género e inclusión'], bg: 'var(--kimsa-terracotta)', accent: '#ffd9b8', photo: { src: '/assets/projects/psicologia-ambiental-home.jpg', tint: 'sunset', label: 'encuentro comunitario · psicología ambiental' }, href: '/servicios/psicologia-ambiental' },
  { name: 'CarbonBox', description: 'Tecnología para la naturaleza: medimos, gestionamos y descarbonizamos huellas ambientales de empresas y organizaciones.', bullets: ['Huella de carbono', 'ISO 14064', 'ISO 14067', 'GHG Protocol', 'Gestión de reducciones', 'Carbono neutralidad'], bg: 'var(--kimsa-plum)', accent: 'var(--kimsa-peach)', photo: { src: '/assets/projects/carbonbox-platform.jpg', tint: 'dusk', label: 'equipo CarbonBox' }, href: '/servicios/carbonbox' },
];

const stats = [
  { n: '+150', l: 'proyectos en América Latina', fg: 'var(--kimsa-terracotta)', bg: 'var(--kimsa-blush)' },
  { n: '+12', l: 'gobiernos apoyados en el Acuerdo de París', fg: 'var(--kimsa-forest)', bg: 'var(--kimsa-tint-forest)' },
  { n: '+8,000', l: 'personas consultadas', fg: 'var(--kimsa-coral)', bg: 'var(--kimsa-tint-coral)' },
  { n: '+1,200', l: 'colaboradores capacitados', fg: 'var(--kimsa-gold)', bg: 'var(--kimsa-tint-gold)' },
];
// Mismas cifras que arriba, partidas en prefijo/valor numérico para el
// contador tipo odómetro del hero (ver OdometerStat).
const heroStats = stats.map((s) => {
  const m = s.n.match(/^(\D*)(.*)$/);
  return { prefix: m?.[1] ?? '', value: m?.[2] ?? s.n, l: s.l };
});


const story = [
  { y: '2017', t: 'Nace KIMSA', d: 'Fundada en Bogotá con vocación latinoamericana.' },
  { y: '2020', t: 'Expansión LATAM', d: 'Expansión y apoyo a proyectos en varios países de América Latina.' },
  { y: '2020', t: 'Alianza con la Fundación InnNature', d: 'El 1% de nuestras utilidades apoya la conservación de la Reserva Ceiba Bruja.' },
  { y: '2022', t: 'Lanzamiento de CarbonBox', d: 'Nuestra plataforma para medir y gestionar huellas.' },
  { y: '2024', t: 'Empresa del Año', d: 'Reconocidas por la Cámara de Comercio de Bogotá.' },
];

const bySlug = (s: string) => PROJECTS.find((p) => p.slug === s)!;
const featured = bySlug('ndc-3-el-salvador');
// Una muestra por área para la Home (el listado completo está en /proyectos)
const secondary = ['mrv-ecuador', 'sostenibilidad-dnp-colombia', 'cluster-solnatura'].map(bySlug);
---
<Base>
  <HomeSectionNav />

  <!-- ============ HERO ============ -->
  <!-- Titular+CTA y cifras conviven en UNA sola sección con un degradado
       continuo (bosque profundo → bosque → terracota → coral): sin cortes
       de sección, el color simplemente fluye de arriba a abajo. Etiqueta de
       marca reubicada como corte vertical en el borde (no como kicker sobre
       el título). -->
  <section class="hero" id="inicio" data-nav-theme="dark">
    <video class="hero__video" autoplay muted loop playsinline aria-hidden="true">
      <source src="/assets/videos/Hero.mp4" type="video/mp4" />
    </video>
    <div class="hero__overlay" aria-hidden="true"></div>
    <Nav overlay />
    <div class="hero__glow hero__glow--peach" aria-hidden="true"></div>
    <div class="hero__glow hero__glow--terracotta" aria-hidden="true"></div>

    <div class="hero-band__grid container">
      <h1 class="hero-band__title">
        Diseñamos soluciones para que la naturaleza y las personas <em class="em-peach">vuelvan a hablarse.</em>
      </h1>
      <div class="hero-band__side">
        <p class="hero-band__lead">
          Somos KIMSA. Una consultora climática joven, nacida en Bogotá en 2017, que
          trabaja desde 8 países de América Latina para enfrentar la crisis climática
          con rigor, frescura y humanidad.
        </p>
        <Button variant="primary" href="#servicios" class="hero-band__cta">Conozca nuestro trabajo →</Button>
      </div>
    </div>

    <!-- Mismas cifras que la sección "Impacto" más abajo, como tira de
         prueba tipo odómetro (derivado de anewclimate.com) — primero la
         promesa, luego la evidencia. -->
    <div class="hero-stats__row container">
      {heroStats.map((s) => (
        <OdometerStat value={s.value} prefix={s.prefix} label={s.l} accent="var(--kimsa-bone)" labelChip />
      ))}
    </div>
  </section>

  <!-- ============ CLIENTES ============ -->
  <section class="section clients">
    <div class="clients__head reveal">
      <MountainMark size={44} class="clients__mark" />
      <p class="clients__statement">Confían en KIMSA · {CLIENT_LOGOS.length} organizaciones en 8 países</p>
    </div>
    <div class="clients__marquee reveal">
      <ClientsMarquee />
    </div>
    <div class="clients__cta reveal">
      <Button variant="secondary" size="sm" href="/clientes">Conoce todas las organizaciones que confían en KIMSA →</Button>
    </div>
  </section>

  <!-- ============ MANIFIESTO / PROPÓSITO ============ -->
  <section class="section manifesto">
    <div class="blob blob--peach" style="top:-100px; right:-100px;"></div>
    <div class="blob blob--sage" style="bottom:-50px; left:-150px;"></div>
    <div class="manifesto__mark"><MountainMark size={320} /></div>
    <div class="manifesto__grid container">
      <div class="reveal manifesto__label">
        <MountainMark size={72} />
        <span class="side-tag">Nuestro propósito</span>
      </div>
      <div>
        <h2 class="h2-lg reveal">
          Generamos <em class="em-forest">productos y soluciones</em> útiles, replicables e
          innovadoras que <em class="em-terracotta">transforman la sociedad</em> — sin hacer enciclopedias.
        </h2>
        <div class="manifesto__values reveal">
          {values.map((v) => <ValueCard title={v.t} accent={v.fg} tint={v.bg}>{v.d}</ValueCard>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SERVICIOS ============ -->
  <section class="section services" id="servicios">
    <div class="services__head container">
      <div class="reveal services__head-left">
        <span class="side-tag">Qué hacemos</span>
        <h2 class="h2">Tres caminos, una misma <em class="em-forest">brújula.</em></h2>
      </div>
      <p class="lead reveal">
        Acompañamos a empresas, gobiernos y comunidades con humanidad, creatividad e
        innovación. Cada proyecto se adapta a su contexto y ritmo.
      </p>
    </div>
    <div class="services__grid container reveal">
      {services.map((s) => <ServiceCard {...s} />)}
    </div>
  </section>

  <!-- ============ IMPACTO ============ -->
  <!-- Sin grilla de cifras (a pedido explícito) — se conserva únicamente el
       reconocimiento Empresa del Año 2024. Sección quieta de una columna,
       buen contrapunto de ritmo después de la cascada de cifras del hero. -->
  <section class="section impact">
    <div class="blob blob--peach" style="top:-80px; left:-80px;"></div>
    <div class="impact__grid container">
      <div class="reveal impact__head">
        <span class="side-tag">Lo que sembramos</span>
        <h2 class="h2-lg">Un trabajo que deja <em class="em-forest">huella.</em></h2>
      </div>
      <p class="impact__text reveal">
        Desde 2017 acompañamos a empresas, gobiernos y comunidades en América
        Latina — un camino constante que la Cámara de Comercio de Bogotá
        reconoció como Empresa del Año 2024.
      </p>
      <div class="impact__badge reveal">
        <img src="/assets/kimsa-camara.png" alt="Cámara de Comercio de Bogotá" />
        <div>
          <div class="impact__badge-title">Empresa del Año 2024</div>
          <div class="impact__badge-sub">Reconocidas por la Cámara de Comercio de Bogotá</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CEIBA BRUJA / CONSERVACIÓN ============ -->
  <section class="section ceiba" id="ceiba" data-nav-theme="dark">
    <div class="blob blob--terracotta" style="top:-100px; right:-100px; width:500px; height:500px;"></div>
    <div class="ceiba__grid container">
      <PhotoPlaceholder class="reveal" src="/assets/projects/ceiba.jpg" alt="Reserva Ceiba Bruja" ratio="4/3" tint="earth" rounded={32} label="reserva ceiba bruja · bosque seco tropical · sierra nevada" />
      <div class="reveal">
        <div class="ceiba__head">
          <span class="side-tag" style="color:var(--kimsa-peach)">Nuestro aporte a la naturaleza</span>
          <h2 class="h2" style="color:var(--kimsa-bone)">
            El <em class="em-peach">1%</em> de nuestras utilidades va a la
            <a class="em-peach ceiba__link" href="https://www.innnature.org/" target="_blank" rel="noopener noreferrer">Reserva Ceiba Bruja</a>,
            en la Sierra Nevada de Santa Marta.
          </h2>
        </div>
        <p class="ceiba__text">
          Desde 2020 generamos una alianza con la <a class="em-peach ceiba__link" href="https://www.innnature.org/" target="_blank" rel="noopener noreferrer">Fundación InnNature</a>,
          con quien trabajamos en la conservación del bosque seco tropical y apoyamos
          proyectos productivos sostenibles para las comunidades locales.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ PROYECTOS ============ -->
  <section class="section projects" id="proyectos-home">
    <div class="projects__head container">
      <div class="reveal projects__head-left">
        <span class="side-tag">Nuestro trabajo</span>
        <h2 class="h2">Proyectos que dejan <em class="em-forest">huella.</em></h2>
      </div>
      <Button variant="ghost" href="/proyectos" class="reveal">Ver todos los proyectos →</Button>
    </div>
    <div class="projects__grid container">
      <Card padded={false} class="reveal projects__featured" data-project={featured.slug} role="button" tabindex="0" aria-label={`Ver ${featured.title}`}>
        <PhotoPlaceholder ratio="16/10" src={featured.image} alt={featured.title} tint={featured.tint} rounded={0} label={`proyecto destacado · ${featured.country}`} />
        <div class="projects__featured-body">
          <span class="projects__badge">Proyecto destacado · {featured.country}</span>
          <h3 class="projects__featured-title">{featured.title}</h3>
          <p class="projects__featured-desc">{featured.summary}</p>
          <div class="projects__tags">
            {featured.tags.map((t) => <span class="projects__tag">{t}</span>)}
          </div>
        </div>
      </Card>
      <div class="projects__col">
        {secondary.map((p) => (
          <div class="reveal projects__small" data-project={p.slug} role="button" tabindex="0" aria-label={`Ver ${p.title}`}>
            <PhotoPlaceholder fill src={p.image} alt={p.title} tint={p.tint} rounded={0} label={p.country} />
            <div class="projects__small-body">
              <div class="projects__small-tag">{p.country}{p.year ? ` · ${p.year}` : ''}</div>
              <h3 class="projects__small-title">{p.title}</h3>
              <p class="projects__small-desc">{p.client}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ NUESTRA HISTORIA ============ -->
  <section class="section story" data-nav-theme="dark">
    <div class="story__mark"><MountainMark size={360} mono="rgba(255,255,255,0.9)" /></div>
    <div class="story__grid container">
      <div class="reveal">
        <div class="story__head">
          <span class="side-tag" style="color:var(--kimsa-peach)">Nuestra historia</span>
          <h2 class="h2" style="color:var(--kimsa-bone)">
            Desde 2017, uniendo <em class="em-peach">naturaleza, personas y sistemas.</em>
          </h2>
        </div>
        <p class="story__text">
          Creemos en el desarrollo consciente. Diseñamos soluciones útiles, replicables
          y alineadas con los Objetivos de Desarrollo Sostenible — sin hacer enciclopedias.
        </p>
      </div>
      <div class="reveal">
        {story.map((s) => (
          <div class="story__item">
            <div class="story__year">{s.y}</div>
            <div>
              <div class="story__item-title">{s.t}</div>
              <div class="story__item-desc">{s.d}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ EQUIPO ============ -->
  <section class="section team" id="equipo">
    <div class="team__grid container">
      <div class="reveal">
        <div class="team__head">
          <span class="side-tag">Las personas</span>
          <h2 class="h2">Un equipo joven, mayormente <em class="em-forest">de mujeres.</em></h2>
        </div>
        <p class="team__text">
          Trabajamos desde casa, desde el campo, desde donde la vida nos encuentre.
          Confiamos en la autonomía y celebramos las distintas formas de trabajar.
        </p>
        <div class="team__band">
          <div class="team__band-n">80%</div>
          <div class="team__band-l">de nuestro equipo está conformado por mujeres</div>
        </div>
      </div>
      <div class="team__people reveal">
        {TEAM.map((m) => (
          <div class="team__person">
            <div class="team__photo" style={`background:linear-gradient(165deg, ${m.color} 0%, color-mix(in srgb, ${m.color} 70%, transparent) 60%, var(--kimsa-peach) 130%)`}>
              <img src={m.img} alt={m.name} />
            </div>
            <div class="team__name">{m.name}</div>
            <div class="team__role">{m.role}</div>
          </div>
        ))}
        <div class="team__person">
          <div class="team__photo team__photo--more">
            <span class="team__more-n">+30</span>
            <MountainMark size={40} mono="rgba(255,255,255,0.9)" />
          </div>
          <div class="team__name">+30 profesionales</div>
          <div class="team__role">HUB latinoamericano</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MAPA / PRESENCIA ============ -->
  <section class="section map">
    <PresenceMap variant="home" />
  </section>

  <!-- ============ CURSO (CTA) ============ -->
  <CourseCTA />

  <!-- ============ CONTACTO ============ -->
  <ContactForm variant="home" />

  <Footer />
  <ProjectModal />
</Base>

<style>
  /* ---------- HERO: una sola banda, degradado continuo ----------
     Todo el hero (titular + cifras) pinta UN solo fondo que fluye de
     bosque profundo a coral; no hay límite de sección que "cortar". */
  .hero {
    position: relative;
    color: var(--kimsa-bone);
    padding-bottom: 64px;
    overflow: hidden;
  }
  /* Video de fondo: cubre toda la sección, detrás del degradado y el
     contenido. Se silencia y hace loop para poder autorreproducirse. */
  .hero__video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  /* Mismo degradado que antes (bosque profundo → bosque → terracota →
     coral), ahora como capa translúcida sobre el video para conservar el
     contraste del texto sin taparlo por completo. El verde domina más
     tiempo antes de virar a naranja, y el naranja/coral final está más
     diluido; opacidad más baja para que el video se note más. */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg,
      var(--kimsa-forest-deep) 0%,
      var(--kimsa-forest) 58%,
      color-mix(in srgb, var(--kimsa-terracotta) 45%, var(--kimsa-cream) 55%) 85%,
      color-mix(in srgb, var(--kimsa-coral) 35%, var(--kimsa-cream) 65%) 100%);
    opacity: 0.64;
    pointer-events: none;
  }
  .hero-band__grid { position: relative; z-index: 2; padding-top: min(18vh, 210px); }
  .hero__glow {
    position: absolute;
    z-index: 1;
    border-radius: 50%;
    filter: blur(70px);
    pointer-events: none;
  }
  .hero__glow--peach { top: -120px; right: -60px; width: 480px; height: 480px; background: radial-gradient(circle, rgba(245,176,131,0.35) 0%, transparent 70%); }
  .hero__glow--terracotta { bottom: 140px; left: 6%; width: 620px; height: 620px; background: radial-gradient(circle, rgba(245,176,131,0.3) 0%, transparent 70%); }
  .hero-band__grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 72px;
    align-items: end;
    padding-left: 56px;
  }
  .hero-band__title { font-weight: 300; font-size: 84px; line-height: 1.03; letter-spacing: -0.025em; margin: 0; }
  .hero-band__side { display: flex; flex-direction: column; gap: 28px; padding-bottom: 6px; }
  .hero-band__lead { font-size: 17px; line-height: 1.6; color: rgba(251, 248, 241, 0.88); margin: 0; }
  .hero-band__cta { align-self: flex-start; }

  /* ---------- HERO: cifras tipo odómetro (misma banda, mitad inferior) ---------- */
  .hero-stats__row {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    margin-top: 88px;
    padding-top: 40px;
    border-top: 1px solid rgba(251, 248, 241, 0.18);
  }

  /* ---------- CLIENTES ---------- */
  .clients { background: var(--kimsa-cream); padding-top: 88px; padding-bottom: 88px; }
  .clients__head { display: flex; flex-direction: column; align-items: center; gap: 16px; margin-bottom: 44px; }
  .clients__statement { font-size: 20px; font-weight: 500; color: var(--kimsa-ink); text-align: center; }
  .clients__marquee { margin: 0 calc(-1 * var(--kimsa-section-x)); } /* a sangre para el bucle */
  .clients__cta { display: flex; justify-content: flex-end; margin-top: 32px; }
  /* HomeSectionNav (la guía de puntos) es fixed a la derecha desde 1240px;
     se le deja el mismo margen para que no se solape con su etiqueta al
     pasar el mouse. */
  @media (min-width: 1240px) {
    .clients__cta { padding-right: 120px; }
  }

  /* ---------- Blobs (decoración) ---------- */
  .blob { position: absolute; width: 400px; height: 400px; border-radius: 50%; filter: blur(40px); pointer-events: none; }
  .blob--peach { background: radial-gradient(circle, rgba(245,176,131,0.53) 0%, transparent 70%); }
  .blob--sage { background: radial-gradient(circle, rgba(111,141,107,0.53) 0%, transparent 70%); }
  .blob--terracotta { background: radial-gradient(circle, rgba(217,108,60,0.4) 0%, transparent 70%); filter: blur(60px); }

  /* ---------- MANIFIESTO ---------- */
  .manifesto { background: linear-gradient(180deg, var(--kimsa-bone) 0%, var(--kimsa-blush) 100%); }
  .manifesto__mark { position: absolute; top: 40px; right: 80px; opacity: 0.15; pointer-events: none; }
  .manifesto__grid { display: grid; grid-template-columns: 0.8fr 1.6fr; gap: 80px; position: relative; }
  .manifesto__label { display: flex; align-items: center; gap: 20px; height: fit-content; }
  .manifesto__values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 64px; }

  /* ---------- SERVICIOS ---------- */
  .services { background: var(--kimsa-bone); }
  .services__head { display: grid; grid-template-columns: 1fr 1.4fr; gap: 80px; margin-bottom: 64px; align-items: end; }
  .services__head-left { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .services__head .lead { max-width: 580px; }
  .services__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: start; }

  /* ---------- IMPACTO ---------- */
  .impact { background: var(--kimsa-cream); }
  .impact__grid { max-width: 720px; margin: 0 auto; text-align: center; position: relative; }
  .impact__head { display: flex; flex-direction: column; align-items: center; gap: 16px; margin-bottom: 24px; }
  .impact__text { font-size: 18px; line-height: 1.6; color: var(--kimsa-ink-soft); max-width: 520px; margin: 0 auto; }
  .impact__badge {
    margin: 40px auto 0;
    max-width: 480px;
    padding: 28px 32px;
    background: var(--kimsa-bone);
    border-radius: var(--kimsa-radius-xl);
    border: 2px solid var(--kimsa-peach);
    box-shadow: var(--kimsa-shadow-card);
    display: flex;
    align-items: center;
    gap: 24px;
    text-align: left;
  }
  .impact__badge img { height: 68px; object-fit: contain; flex-shrink: 0; }
  .impact__badge-title { font-weight: 600; font-size: 18px; }
  .impact__badge-sub { font-size: 14px; color: var(--kimsa-ink-soft); margin-top: 2px; }

  /* ---------- CEIBA ---------- */
  .ceiba { background: linear-gradient(135deg, var(--kimsa-forest) 0%, var(--kimsa-forest-deep) 60%, #2d1e3d 100%); color: var(--kimsa-bone); }
  .ceiba__grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 80px; align-items: center; position: relative; }
  .ceiba__head { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-bottom: 32px; }
  .ceiba__text { font-size: 17px; line-height: 1.6; color: rgba(251,248,241,0.85); max-width: 520px; }
