---
import Base from '../layouts/Base.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/core/Button.astro';
import DocumentCard from '../components/surfaces/DocumentCard.astro';
import { DOCUMENTS, AREAS } from '../data/site';
---
<Base
  title="Publicaciones · KIMSA"
  description="Documentos, informes y estudios elaborados por KIMSA en sus proyectos de gestión climática, psicología ambiental y tecnología para la naturaleza en América Latina."
>
  <section class="pub-hero">
    <Nav />
    <div class="container pub-hero__inner reveal">
      <nav class="pub-hero__crumb" aria-label="Ruta"><a href="/">Inicio</a> / <span class="current">Publicaciones</span></nav>
      <h1 class="pub-hero__title">Publicaciones con <em class="em-forest">respaldo técnico.</em></h1>
      <p class="pub-hero__lead">
        Informes, hojas de ruta y estudios que KIMSA elaboró o co-elaboró junto a gobiernos,
        agencias y organizaciones en América Latina. Cada documento incluye el aporte concreto
        de KIMSA y un enlace directo al texto completo.
      </p>
    </div>
  </section>

  <section class="section" style="background:var(--kimsa-cream-deep)">
    <div class="container">
      <div class="pub-search reveal">
        <svg class="pub-search-icon" viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.6" />
          <path d="M14 14L18 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <input
          type="search"
          id="pub-search"
          class="pub-search-input"
          placeholder="Buscar publicaciones por título, cliente o palabra clave…"
          aria-label="Buscar publicaciones"
        />
      </div>

      <div class="pub-filters reveal" role="tablist" aria-label="Filtrar por área">
        <button class="pub-filter is-active" data-filter="all">Todas</button>
        {AREAS.map((a) => (
          <button class="pub-filter" data-filter={a.key} style={`--dot:${a.color}`}>{a.label}</button>
        ))}
      </div>
      <div class="pub-grid reveal">
        {DOCUMENTS.map((doc) => (
          <div
            class="pub-grid__item"
            data-area={doc.area}
            data-search={`${doc.title} ${doc.client} ${doc.contribution} ${doc.tags.join(' ')}`.toLowerCase()}
          >
            <DocumentCard doc={doc} />
          </div>
        ))}
      </div>
      <p class="pub-empty" id="pub-empty" hidden>No hay publicaciones con estos filtros.</p>
    </div>
  </section>

  <!-- CTA contacto -->
  <section class="section" style="background:var(--kimsa-forest); color:var(--kimsa-bone)">
    <div class="container pub-cta reveal">
      <h2 class="h2" style="color:var(--kimsa-bone); margin-bottom:20px">
        ¿Necesita un documento técnico <em class="em-peach">a la medida?</em>
      </h2>
      <p style="font-size:18px; color:rgba(251,248,241,0.85); max-width:560px; margin-bottom:32px">
        Conversemos sobre el reto que su organización necesita documentar.
      </p>
      <Button variant="primary" size="lg" href="/contacto">Conversemos →</Button>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .pub-hero { position: relative; background: linear-gradient(180deg, var(--kimsa-bone) 0%, rgba(246,208,194,0.5) 100%); padding-bottom: 96px; }
  .pub-hero__inner { padding-top: 8px; }
  .pub-hero__crumb { font-size: 13px; color: var(--kimsa-ink-soft); margin: 108px 0 48px; }
  .pub-hero__crumb a:hover { color: var(--kimsa-terracotta); }
  .pub-hero__crumb .current { color: var(--kimsa-terracotta); font-weight: 600; }
  .pub-hero__title { font-weight: 300; font-size: 72px; line-height: 1.05; letter-spacing: -0.025em; margin: 20px 0 28px; max-width: 900px; }
  .pub-hero__lead { font-size: 20px; line-height: 1.55; color: var(--kimsa-ink-soft); max-width: 640px; }

  .pub-search {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 460px;
    margin-bottom: 24px;
    padding: 12px 18px;
    background: var(--kimsa-surface-card);
    border: 1.5px solid var(--kimsa-rule);
    border-radius: var(--kimsa-radius-pill);
    transition: border-color var(--kimsa-dur) var(--kimsa-ease);
  }
  .pub-search:focus-within { border-color: var(--kimsa-terracotta); }
  .pub-search-icon { color: var(--kimsa-ink-soft); flex-shrink: 0; }
  .pub-search-input {
    flex: 1;
    border: none;
    background: none;
    outline: none;
    font-family: var(--kimsa-font-sans);
    font-size: 14px;
    color: var(--kimsa-ink);
  }
  .pub-search-input::placeholder { color: var(--kimsa-ink-soft); }
  .pub-search-input::-webkit-search-cancel-button { cursor: pointer; }

  .pub-filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 36px; }
  .pub-filter {
    font-family: var(--kimsa-font-sans);
    font-size: 14px;
    font-weight: 500;
    padding: 10px 18px;
    border-radius: var(--kimsa-radius-pill);
    border: 1px solid var(--kimsa-rule);
    background: var(--kimsa-surface-card);
    color: var(--kimsa-ink-soft);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: background var(--kimsa-dur) var(--kimsa-ease), color var(--kimsa-dur) var(--kimsa-ease), border-color var(--kimsa-dur) var(--kimsa-ease);
  }
  .pub-filter[data-filter]:not([data-filter="all"])::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--dot);
  }
  .pub-filter:hover { border-color: var(--kimsa-terracotta); color: var(--kimsa-ink); }
  .pub-filter.is-active { background: var(--kimsa-forest); color: var(--kimsa-bone); border-color: var(--kimsa-forest); }

  .pub-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .pub-grid__item[hidden] { display: none; }
  .pub-empty { text-align: center; color: var(--kimsa-ink-soft); padding: 40px 0; }

  .pub-cta { text-align: center; display: flex; flex-direction: column; align-items: center; }

  @media (max-width: 1080px) {
    .pub-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .pub-hero__title { font-size: 44px; }
    .pub-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.pub-filter');
  const items = document.querySelectorAll<HTMLElement>('.pub-grid__item');
  const search = document.getElementById('pub-search') as HTMLInputElement | null;
  const empty = document.getElementById('pub-empty');
  let activeArea = 'all';
  let query = '';

  function apply() {
    let visible = 0;
    items.forEach((item) => {
      const okArea = activeArea === 'all' || item.dataset.area === activeArea;
      const okQuery = query === '' || (item.dataset.search || '').includes(query);
      const show = okArea && okQuery;
      item.hidden = !show;
      if (show) visible++;
    });
    if (empty) empty.hidden = visible !== 0;
  }

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      filters.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      activeArea = btn.dataset.filter ?? 'all';
      apply();
    });
  });

  search?.addEventListener('input', () => {
    query = search.value.trim().toLowerCase();
    apply();
  });
</script>
