---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/layout/Footer.astro';
import ServiceHero from '../../components/sections/ServiceHero.astro';
import StatBand from '../../components/sections/StatBand.astro';
import NumberedCard from '../../components/surfaces/NumberedCard.astro';
import ProjectsCarousel from '../../components/sections/ProjectsCarousel.astro';
import ProjectModal from '../../components/sections/ProjectModal.astro';
import Button from '../../components/core/Button.astro';
import { projectsByArea } from '../../data/site';
import { getCarbonBoxPosts, CARBONBOX_BLOG_URL, CARBONBOX_ACADEMY_URL } from '../../lib/carbonboxBlog';

const stats = [
  { n: '50+', l: 'clientes satisfechos' },
  { n: '13.000+', l: 'toneladas de gases de efecto invernadero gestionadas' },
  { n: '6', l: 'sectores de la economía abordados' },
  { n: '500+', l: 'colaboradores capacitados en descarbonización' },
];

const areas = [
  { t: 'Huella organizacional', d: 'Inventario de GEI de alcances 1, 2 y 3 bajo ISO 14064-1 y GHG Protocol, de una sede o de varias.', fg: 'var(--kimsa-plum)', bg: 'var(--kimsa-tint-plum)' },
  { t: 'Huella de eventos', d: 'Congresos, festivales y eventos masivos, con análisis de ciclo de vida.', fg: 'var(--kimsa-terracotta)', bg: 'var(--kimsa-tint-terracotta)' },
  { t: 'Huella de producto', d: 'Estimamos las emisiones con análisis de ciclo de vida (ACV) bajo ISO 14067 y 14040/44.', fg: 'var(--kimsa-gold)', bg: 'var(--kimsa-tint-gold)' },
  { t: 'Reducción y descarbonización', d: 'Escenarios de mitigación, proyecciones, metas y ruta a la carbono neutralidad. La capacitación de su equipo va incluida en los planes.', fg: 'var(--kimsa-forest)', bg: 'var(--kimsa-tint-forest)' },
];

// Elementos del servicio: no son pasos en secuencia sino las piezas que
// incluye la suscripción, por eso van sin numeración.
const elementos = [
  { t: 'Diagnóstico y propuesta', d: 'Suscripción anual con precios estandarizados según sector, tamaño y plan.', c: 'var(--kimsa-plum)' },
  { t: 'Captura de datos y cálculo', d: 'Automatizamos la recopilación y la carga de datos, con factores de emisión locales.', c: 'var(--kimsa-terracotta)' },
  { t: 'Reporte y tablero de datos', d: 'Analice sus resultados y genere un reporte automático.', c: 'var(--kimsa-gold)' },
  { t: 'Plan de reducción', d: 'Plan de reducción o de descarbonización y preparación de auditorías con terceros.', c: 'var(--kimsa-forest)' },
];

const planes = [
  { t: 'Esencial', d: 'Autogestión en la plataforma.' },
  { t: 'Pro', d: 'Experto dedicado y revisión de datos.' },
  { t: 'Experto', d: 'Preparación para la verificación externa.' },
];

const perfiles = [
  { t: 'Le exigen la huella', d: 'Empresas a las que un cliente o una licitación les pide su huella de carbono.' },
  { t: 'Reportan a su casa matriz', d: 'Filiales que deben entregar su inventario de emisiones a la compañía matriz, como Parker.' },
  { t: 'Organizan eventos', d: 'Organizadores de eventos y recintos, como BTC Americas o el Hotel Waya.' },
];
const sectores = ['Salud', 'Alimentos', 'Energía', 'Educación', 'Sector público', 'Eventos'];

const diferenciales = [
  { t: 'Software y experto en una sola suscripción', c: 'var(--kimsa-plum)' },
  { t: 'Factores de emisión locales, no genéricos del IPCC', c: 'var(--kimsa-terracotta)' },
  { t: 'En español y pensado para Latinoamérica', c: 'var(--kimsa-gold)' },
  { t: 'Respaldo técnico de KIMSA desde 2017', c: 'var(--kimsa-forest)' },
];

const refs = projectsByArea('carbonbox');

// Últimos artículos de carbonbox.app/blog, traídos en tiempo de build (ver
// src/lib/carbonboxBlog.ts). Si el fetch falla o su HTML cambió de forma
// inesperada, carbonboxPosts queda vacío y la grilla simplemente no se
// renderiza — nunca debe romper el build de este sitio.
const carbonboxPosts = await getCarbonBoxPosts(3);
---
<Base title="CarbonBox · Tecnología para la naturaleza · KIMSA" description="CarbonBox digitaliza la gestión ambiental para empresas y organizaciones: mide, reduce y gestiona tu huella de carbono.">
  <ServiceHero
    crumb="CarbonBox"
    titleMain="Carbon"
    titleEm="Box"
    joined
    emColor="#1620a4"
    logo="/assets/carbonbox-logo-t.png"
    lead="Plataforma de huella de carbono para empresas en Latinoamérica que buscan descarbonizar sus cadenas productivas."
    photo="/assets/projects/carbonbox-platform.jpg"
    photoTint="dusk"
    photoLabel="plataforma CarbonBox · panel de medición de huella"
    ctaHref="https://www.carbonbox.app"
  />

  <StatBand stats={stats} bg="var(--kimsa-plum)" />

  <!-- Lo que medimos -->
  <section class="section" style="background:var(--kimsa-cream)">
    <div class="svc-head container">
      <div class="reveal svc-head-left">
        <span class="side-tag">Qué hacemos</span>
        <h2 class="h2">Lo que medimos y <em style="font-style:italic;font-weight:400;color:var(--kimsa-plum)">cómo lo reducimos.</em></h2>
      </div>
      <p class="lead reveal">
        CarbonBox reúne en un solo lugar la medición, la reducción y el reporte de su
        impacto ambiental, con acompañamiento experto.
      </p>
    </div>
    <div class="svc-cards container reveal">
      {areas.map((a) => (
        <NumberedCard title={a.t} accent={a.fg} tint={a.bg}>{a.d}</NumberedCard>
      ))}
    </div>
  </section>

  <!-- Cómo funciona: elementos de la suscripción + planes -->
  <section class="section" style="background:var(--kimsa-bone)">
    <div class="container">
      <div class="svc-head-left reveal" style="margin-bottom:40px">
        <span class="side-tag">Cómo funciona</span>
        <h2 class="h2" style="margin:0">Todo en una sola <em style="font-style:italic;font-weight:400;color:var(--kimsa-plum)">suscripción.</em></h2>
      </div>
      <div class="elems reveal">
        {elementos.map((e) => (
          <div class="elem" style={`border-color:color-mix(in srgb, ${e.c} 33%, transparent)`}>
            <h3 class="elem__title" style={`color:${e.c}`}><span class="dot" style={`background:${e.c}`}></span>{e.t}</h3>
            <p class="elem__desc">{e.d}</p>
          </div>
        ))}
      </div>

      <div class="plans reveal">
        <span class="plans__label">Planes</span>
        <div class="plans__grid">
          {planes.map((pl) => (
            <div class="plan">
              <h3 class="plan__name">{pl.t}</h3>
              <p class="plan__desc">{pl.d}</p>
            </div>
          ))}
        </div>
      </div>

      <p class="cb-note reveal">
        <strong>CarbonBox no certifica:</strong> preparamos su inventario y a su equipo para la
        verificación por un organismo acreditado.
      </p>
    </div>
  </section>

  <!-- Para quién -->
  <section class="section" style="background:var(--kimsa-cream)">
    <div class="container">
      <div class="svc-head-left reveal" style="margin-bottom:40px">
        <span class="side-tag">Para quién</span>
        <h2 class="h2" style="margin:0">¿Es CarbonBox <em style="font-style:italic;font-weight:400;color:var(--kimsa-plum)">para usted?</em></h2>
      </div>
      <div class="profiles reveal">
        {perfiles.map((pf) => (
          <div class="profile">
            <h3 class="profile__title">{pf.t}</h3>
            <p class="profile__desc">{pf.d}</p>
          </div>
        ))}
      </div>
      <div class="sectors reveal">
        <span class="sectors__label">Sectores atendidos</span>
        <ul class="sectors__list">
          {sectores.map((sc) => <li>{sc}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Por qué CarbonBox -->
  <section class="section" style="background:var(--kimsa-bone)">
    <div class="container">
      <div class="svc-head-left reveal" style="margin-bottom:40px">
        <span class="side-tag">Por qué CarbonBox</span>
        <h2 class="h2" style="margin:0">Ni solo consultoría, <em style="font-style:italic;font-weight:400;color:var(--kimsa-plum)">ni solo software.</em></h2>
      </div>
      <div class="diffs reveal">
        {diferenciales.map((df) => (
          <div class="diff" style={`background:linear-gradient(160deg, color-mix(in srgb, ${df.c} 16%, var(--kimsa-bone)) 0%, var(--kimsa-bone) 100%)`}>
            <span class="diff__bar" style={`background:${df.c}`}></span>
            <p class="diff__text">{df.t}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Referencias -->
  <section class="section" id="casos" style="background:var(--kimsa-cream-deep)">
    <div class="container">
      <div class="svc-head-left reveal" style="margin-bottom:20px">
        <span class="side-tag">Referencias</span>
        <h2 class="h2" style="margin:0">CarbonBox en <em style="font-style:italic;font-weight:400;color:var(--kimsa-plum)">acción.</em></h2>
      </div>
      <p class="lead reveal" style="margin-bottom:40px">Haga clic en el proyecto para ver el detalle completo.</p>
      <ProjectsCarousel projects={refs} id="pc-carbon" />
    </div>
  </section>

  <!-- Blog + CarbonBox Academy: los artículos se sincronizan solos desde
       carbonbox.app/blog en cada build (ver src/lib/carbonboxBlog.ts). -->
  <section class="section" id="blog" style="background:var(--kimsa-bone)">
    <div class="container">
      <div class="svc-head-left reveal" style="margin-bottom:20px">
        <span class="side-tag">Blog</span>
        <h2 class="h2" style="margin:0">Ideas y ciencia para <em style="font-style:italic;font-weight:400;color:var(--kimsa-plum)">descarbonizar.</em></h2>
      </div>
      <p class="lead reveal" style="margin-bottom:40px">Artículos del equipo de CarbonBox sobre huella de carbono, normativa y estrategia de sostenibilidad.</p>

      {carbonboxPosts.length > 0 && (
        <div class="cb-blog-grid reveal">
          {carbonboxPosts.map((p) => (
            <a class="cb-blog-card" href={p.url} target="_blank" rel="noopener noreferrer">
              {p.cover && <div class="cb-blog-card__media"><img src={p.cover} alt={p.title} loading="lazy" /></div>}
              <div class="cb-blog-card__body">
                {p.category && <span class="cb-blog-card__tag">{p.category}</span>}
                <h3 class="cb-blog-card__title">{p.title}</h3>
                {p.excerpt && <p class="cb-blog-card__excerpt">{p.excerpt}</p>}
                {p.date && <span class="cb-blog-card__date">{p.date}</span>}
              </div>
            </a>
          ))}
        </div>
      )}

      <p class="cb-blog-more reveal">
        <a href={CARBONBOX_BLOG_URL} target="_blank" rel="noopener noreferrer">Ver todos los artículos en carbonbox.app/blog →</a>
      </p>

      <div class="cb-academy reveal">
        <div class="cb-academy__text">
          <span class="side-tag">CarbonBox Academy</span>
          <p>Guías, webinars y masterclasses gratuitas para gestionar tu huella de carbono de forma autónoma.</p>
        </div>
        <Button variant="primary" size="md" href={CARBONBOX_ACADEMY_URL} target="_blank" rel="noopener noreferrer">
          Ir a CarbonBox Academy →
        </Button>
      </div>
    </div>
  </section>

  <!-- Cierre: última invitación a contactar -->
  <section class="section cb-close">
    <div class="container cb-close__inner reveal">
      <h2 class="h2 cb-close__title">¿Le pidieron su huella de carbono?</h2>
      <p class="cb-close__lead">Le decimos en una llamada qué alcance necesita y cuánto cuesta.</p>
      <Button variant="cream" size="lg" href="/contacto">Agendar con un experto →</Button>
      <p class="cb-close__note">Respuesta en menos de 24 horas hábiles.</p>
    </div>
  </section>

  <Footer />
  <ProjectModal />
</Base>

<style>
  .svc-head { display: grid; grid-template-columns: 1fr 1.4fr; gap: 64px; align-items: end; margin-bottom: 56px; }
  .svc-head .lead { max-width: 540px; }
  .svc-head-left { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .svc-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .elems { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .elem { padding: 28px; border: 2px solid; border-radius: var(--kimsa-radius-xl); background: var(--kimsa-bone); }
  .elem__title { font-weight: 600; font-size: 20px; line-height: 1.25; margin: 0 0 12px; display: flex; align-items: baseline; gap: 10px; }
  .elem__title .dot { width: 8px; height: 8px; border-radius: 999px; flex-shrink: 0; transform: translateY(-2px); }
  .elem__desc { font-size: 15px; color: var(--kimsa-ink-soft); line-height: 1.55; margin: 0; }

  .plans { margin-top: 40px; padding: 28px 32px; border-radius: var(--kimsa-radius-xl); background: var(--kimsa-tint-plum); display: grid; grid-template-columns: auto 1fr; gap: 32px; align-items: center; }
  .plans__label { font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--kimsa-plum); }
  .plans__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .plan { background: var(--kimsa-bone); border-radius: 20px; padding: 18px 22px; }
  .plan__name { font-weight: 600; font-size: 19px; color: var(--kimsa-plum); margin: 0 0 4px; }
  .plan__desc { font-size: 14px; color: var(--kimsa-ink-soft); line-height: 1.5; margin: 0; }

  .cb-note { margin: 24px 0 0; padding: 18px 22px; border-left: 4px solid var(--kimsa-plum); background: var(--kimsa-cream); border-radius: 0 12px 12px 0; font-size: 15px; line-height: 1.55; color: var(--kimsa-ink); max-width: 760px; }
  .cb-note strong { color: var(--kimsa-plum); }

  .profiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .profile { padding: 28px; border-radius: var(--kimsa-radius-xl); background: var(--kimsa-surface-card); box-shadow: var(--kimsa-shadow-card); }
  .profile__title { font-weight: 600; font-size: 20px; margin: 0 0 10px; color: var(--kimsa-plum); }
  .profile__desc { font-size: 15px; color: var(--kimsa-ink-soft); line-height: 1.55; margin: 0; }
  .sectors { margin-top: 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .sectors__label { font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--kimsa-ink-soft); }
  .sectors__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .sectors__list li { font-size: 14px; font-weight: 500; padding: 6px 14px; border-radius: 999px; border: 1.5px solid color-mix(in srgb, var(--kimsa-plum) 35%, transparent); color: var(--kimsa-plum); }

  .diffs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .diff { padding: 28px; border-radius: var(--kimsa-radius-xl); display: flex; flex-direction: column; gap: 18px; min-height: 160px; }
  .diff__bar { width: 36px; height: 4px; border-radius: 999px; }
  .diff__text { font-size: 19px; font-weight: 500; line-height: 1.35; margin: 0; color: var(--kimsa-ink); }

  .cb-close { background: linear-gradient(135deg, var(--kimsa-plum) 0%, #7d3553 100%); color: var(--kimsa-bone); }
  .cb-close__inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .cb-close__title { margin: 0; color: var(--kimsa-bone); }
  .cb-close__lead { font-size: 19px; line-height: 1.55; margin: 0 0 8px; max-width: 560px; opacity: 0.9; }
  .cb-close__note { font-size: 14px; margin: 0; opacity: 0.75; }
  .svc-refs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 820px; }

  .cb-blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 24px; }
  .cb-blog-card {
    display: flex;
    flex-direction: column;
    background: var(--kimsa-surface-card);
    border-radius: var(--kimsa-radius-xl);
    box-shadow: var(--kimsa-shadow-card);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform var(--kimsa-dur) var(--kimsa-ease), box-shadow var(--kimsa-dur) var(--kimsa-ease);
  }
  .cb-blog-card:hover { transform: translateY(-4px); box-shadow: var(--kimsa-shadow-lift); }
  .cb-blog-card__media { aspect-ratio: 16/9; overflow: hidden; background: var(--kimsa-cream); }
  .cb-blog-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .cb-blog-card__body { padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .cb-blog-card__tag { align-self: flex-start; font-size: 11px; font-weight: 600; letter-spacing: 0.04em; color: var(--kimsa-plum); background: var(--kimsa-tint-plum); border-radius: 999px; padding: 5px 12px; }
  .cb-blog-card__title { font-weight: 500; font-size: 19px; line-height: 1.3; margin: 0; }
  .cb-blog-card__excerpt { font-size: 14px; color: var(--kimsa-ink-soft); line-height: 1.55; margin: 0; }
  .cb-blog-card__date { margin-top: auto; padding-top: 6px; font-size: 13px; font-weight: 600; color: var(--kimsa-ink-soft); }

  .cb-blog-more { margin: 0 0 40px; }
  .cb-blog-more a { font-size: 14px; font-weight: 600; color: var(--kimsa-plum); }
  .cb-blog-more a:hover { text-decoration: underline; }

  .cb-academy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding: 32px 36px;
    border-radius: var(--kimsa-radius-xl);
    background: var(--kimsa-tint-gold);
  }
  .cb-academy__text p { margin: 8px 0 0; font-size: 15px; color: var(--kimsa-ink-soft); max-width: 480px; }

  @media (min-width: 901px) and (max-width: 1100px) {
    .svc-cards, .elems, .diffs { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .svc-head { grid-template-columns: 1fr; gap: 24px; }
    .svc-cards, .elems, .svc-refs, .cb-blog-grid, .profiles, .diffs, .plans, .plans__grid { grid-template-columns: 1fr; }
    .plans { gap: 16px; }
  }
</style>
